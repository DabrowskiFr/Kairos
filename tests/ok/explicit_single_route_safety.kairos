type SignalColor = Red | Green;
type RouteState = Idle | Locked;
type Track = T1;
type Route = R1;

node explicit_single_route_safety(
  occupied[T1]: bool
) returns (
  signal[R1]: SignalColor,
  routeState[R1]: RouteState,
  reserved[R1]: bool
)
contracts
  ensures: G(routeState[R1] = Locked => X(reserved[R1] = true W routeState[R1] = Idle));
  ensures: G(signal[R1] = Green => occupied[T1] = false);
states
  Init(init), Run;
invariants
  in Run:
    signal[R1] = Red;
    routeState[R1] = Idle;
    reserved[R1] = false;
transitions
  Init:
    to Run {
      signal[R1] := Red;
      routeState[R1] := Idle;
      reserved[R1] := false;
    }
  Run:
    to Run {
      signal[R1] := Red;
      routeState[R1] := Idle;
      reserved[R1] := false;
    }
end
