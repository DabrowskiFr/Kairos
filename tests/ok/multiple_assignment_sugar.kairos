node multiple_assignment_sugar(x: int) returns (
  a: int, b: int,
  ok: bool
)
method setPair() {
  a, b := x, x + 1;
  ok := true;
}
contracts
  guarantee: X G(ok = true);
states
  Init(init), Run;
transitions
  Init:
    to Run {
      setPair();
    }
  Run:
    to Run {
      setPair();
    }
end
