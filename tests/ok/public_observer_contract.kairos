node public_observer_contract(x: int) returns (
  out: int
)
observers
  total : int = x -> pre(total) + x;
contracts
  assume: G(x >= 0);
  guarantee: G(total >= 0);
  guarantee: G(out = x);
states
  Init(init), Run;
transitions
  Init:
    to Run {
      out := x;
    }
  Run:
    to Run {
      out := x;
    }
end
