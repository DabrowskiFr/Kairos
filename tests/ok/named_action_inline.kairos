type Route = R1 | R2;

node named_action_inline(
  request[Route]: bool
) returns (
  locked[Route]: bool,
  enabled[Route]: bool
)
ghosts
  proofLocked[Route]: bool;

predicate mirrored() =
  forall r in Route. proofLocked[r] = locked[r];

method clearRoute(
  inout routeLocked: bool,
  inout routeEnabled: bool,
  inout routeProofLocked: bool
) {
  routeLocked := false;
  routeEnabled := false;
  routeProofLocked := false;
}

method lockRoute(
  inout routeLocked: bool,
  inout routeEnabled: bool,
  inout routeProofLocked: bool
) {
  routeLocked := true;
  routeEnabled := true;
  routeProofLocked := true;
}

contracts
  guarantee: forall r in Route.
    G(enabled[r] = true => locked[r] = true);

states Init(init), Run;

invariants
  in Run:
    mirrored();

trans
  Init:
    to Run {
      for r in Route {
        clearRoute(locked[r], enabled[r], proofLocked[r]);
      }
    }

  Run:
    to Run {
      for r in Route {
        if request[r] then
          lockRoute(locked[r], enabled[r], proofLocked[r]);
        else
          clearRoute(locked[r], enabled[r], proofLocked[r]);
        end;
      }
    }
end
