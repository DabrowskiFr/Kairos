node derived_state_outputs(
  start: bool, fault: bool
) returns (
  motorOn: bool, alarmLatched: bool
)

contracts
  ensures: G(alarmLatched = true => motorOn = false);

states Init(init), Idle, Running, Alarm;
derive motorOn = state in Running;
derive alarmLatched = state in Alarm;

transitions
  Init:
    to Alarm when fault = true { skip; }
    to Running when start = true { skip; }
    to Idle { skip; }

  Idle:
    to Alarm when fault = true { skip; }
    to Running when start = true { skip; }
    to Idle { skip; }

  Running:
    to Alarm when fault = true { skip; }
    to Running when start = true { skip; }
    to Idle { skip; }

  Alarm:
    to Alarm { skip; }
end
