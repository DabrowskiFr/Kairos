node action_contract_inline(x: int) returns (y: int)
method assignNonNeg(inout target: int, value: int)
contracts
  requires: value >= 0;
  ensures: target = old(target) + value;
{
  target := target + value;
}

contracts
  assume: G(x >= 0);
  guarantee: G(y = y);

states Init(init);

trans
  Init:
    to Init {
      assignNonNeg(y, x);
    }
end
