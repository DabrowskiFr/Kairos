// BAD INVARIANT — the delay register is claimed to add a calibration unit.
// The implementation copies [x] exactly, so the shifted relation is not inductive.
node delay_int(x: int) returns (y: int)
contracts
  ensures: X ( G (y =  prev x) );
locals
  z : int;
states
  Init(init), Run;
invariants
  in Run:
    z = prev x + 1;
transitions
  Init:
    to Run  {
    z := x;
  }
  Run:
    to Run  {
    y := z;
    z := x;
  }
end
