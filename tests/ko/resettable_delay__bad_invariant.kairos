// BAD INVARIANT — the delay memory is claimed to stay cleared in normal mode.
// A non-reset transition loads [x] into [m], so induction fails for nonzero data.
node resettable_delay(reset: int, x: int) returns (y: int)
contracts
  assume : G ((reset = 0 or reset = 1) and (reset = 1 => x = 0));
  guarantee  : G ((reset = 1) => (y = 0));
  guarantee  : X G ((reset = 0 and prev reset = 1) => y = 0);
  guarantee  : X G ((reset = 0 and prev reset = 0) => y = prev x);
locals
  m : int;
states
  Init(init), Run;
invariants
  in Run:
    (prev reset = 1 => m = 0) and (prev reset = 0 => m = 0);
transitions
  Init:
    to Run when reset = 1 { y := 0; m := 0; }
    to Run when reset = 0 { y := 0; m := x; }
  Run:
    to Run when reset = 1 { y := 0; m := 0; }
    to Run when reset = 0 { y := m; m := x; }
end
  
