type Mode = Idle | Running;

node match_unreachable_default(mode: Mode) returns (code: int)
contracts
  guarantee: G(code >= 0);
states Init(init), Run;
transitions
  Init:
    to Run { code := 0; }
  Run:
    to Run {
      match mode with
      | Idle { code := 0; }
      | Running { code := 1; }
      | _ { code := 2; }
      end;
    }
end
