// BAD CODE — should be rejected by the verifier.
// The Run step emits 0 instead of the stored previous input.
// It therefore violates the one-cycle-delay guarantee.
node delay_int(x: int) returns (y: int)
contracts
  ensures: X ( G (y =  prev x) );
locals
  z : int;
states
  Init(init), Run;
invariants
  in Run:
    z = prev x;
transitions
  Init:
    to Run  {
    z := x;
  }
  Run:
    to Run  {
    y := 0;
    z := x;
  }
end
