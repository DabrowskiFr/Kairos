// BAD CODE — should be rejected by the verifier.
// While the gate stays high, Hold emits 1 instead of preserving 0.
// This violates the Hold invariant and the weak-until guarantee.
node w_guarded_prev_hold(gate: int, x: int) returns (y: int)
contracts
  assume: G(gate = 0 or gate = 1);
  guarantee: next always ((gate = 1 and prev gate = 1) => ((y = 0) W (gate = 0)));
locals
  hold: int;
states
  Init(init), Wait, Hold;
invariants
  in Hold:
    y = 0;
transitions
  Init:
    to Hold when gate = 1 {
      y := 0;
      hold := x;
    }
    to Wait when gate = 0 {
      y := 0;
      hold := x;
    }
  Wait:
    to Hold when gate = 1 {
      y := 0;
      hold := x;
    }
    to Wait when gate = 0 {
      y := 0;
      hold := x;
    }
  Hold:
    to Wait when gate = 0 {
      y := 0;
      hold := x;
    }
    to Hold when gate = 1 {
      y := 1;
      hold := x;
    }
end
