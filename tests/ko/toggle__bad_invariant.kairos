// BAD INVARIANT — Run is incorrectly assumed to keep the output low.
// The normal toggle step changes y from 0 to 1, invalidating y = 0.
node toggle() returns (y: int)
contracts
  guarantee: y = 0;
  guarantee: G ( y = 0 => X ( y = 1 ) );
  guarantee: G ( y = 1 => X ( y = 0 ) );
states
  Init(init), Run;
invariants
  in Run:
    y = 0;
transitions
  Init:
    to Run  {
    y := 0;
  }
  Run:
    to Run  {
    y := 1 - y;
  }
end
