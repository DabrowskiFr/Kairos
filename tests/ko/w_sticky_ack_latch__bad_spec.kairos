// BAD SPECIFICATION — the latched acknowledgement has reversed polarity.
// Once armed, the implementation holds ack = 1 until drop is asserted.
node w_sticky_ack_latch(arm: int, drop: int) returns (ack: int)
contracts
  assume: G((arm = 0 or arm = 1) and (drop = 0 or drop = 1));
  guarantee: next always ((arm = 1) => ((ack = 0) W (drop = 1)));
states
  Init(init), Idle, Latched;
invariants
  in Idle:
    ack = 0;
  in Latched:
    ack = 1;
transitions
  Init:
    to Latched when arm = 1 and drop = 0 {
      ack := 1;
    }
    to Idle when not (arm = 1 and drop = 0) {
      ack := 0;
    }
  Idle:
    to Latched when arm = 1 and drop = 0 {
      ack := 1;
    }
    to Idle when not (arm = 1 and drop = 0) {
      ack := 0;
    }
  Latched:
    to Idle when drop = 1 {
      ack := 0;
    }
    to Latched when drop = 0 {
      skip;
    }
end
