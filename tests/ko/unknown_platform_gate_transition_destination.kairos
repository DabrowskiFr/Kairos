// A platform gate transition must finish in a declared physical position.
// Fault: Opening is used as a destination but is not a declared state.
node platform_gate_unknown_destination(request_open: bool) returns (gate_open: bool)
contracts
  ensures: G (gate_open = true => request_open = true);
states
  Init(init), Closed, Open;
transitions
  Init:
    to Closed {
      gate_open := false;
    }
  Closed:
    to Opening when request_open = true {
      gate_open := true;
    }
    to Closed {
      gate_open := false;
    }
  Open:
    to Closed when request_open = false {
      gate_open := false;
    }
    to Open {
      gate_open := true;
    }
end
