node observer_pre_in_init(x: int) returns (ok: bool)
observers
  delayed : int
    init {
      delayed := pre(x);
    }
    step {
      delayed := pre(x);
    }
contracts
  guarantee: X G(ok = true);
states
  Init(init), Run;
transitions
  Init:
    to Run { ok := true; }
  Run:
    to Run { ok := true; }
end
