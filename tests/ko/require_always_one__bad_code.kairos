// BAD CODE — should be rejected by the verifier.
// The controller emits 0 although its assumption fixes inp to 1.
// This directly violates the guarantee that out is always 1.
node require_always_one(inp: int) returns (out: int)
contracts
  assume: G (inp = 1);
  guarantee: G (out = 1);
states
  S(init);
transitions
  S:
    to S {
      out := 0;
    }
end
