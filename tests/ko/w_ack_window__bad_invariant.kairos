// BAD INVARIANT — Run is incorrectly assumed to keep acknowledgement asserted.
// A request-free step sets ack to 0, contradicting the claimed ack = 1.
node w_ack_window(req: int) returns (ack: int)
contracts
  requires: G(req = 0 or req = 1);
  ensures: X G((req = 1) => ((ack = 1) W (req = 0)));
states
  Init(init), Run;
invariants
  in Run:
    ack = 1;
transitions
  Init:
    to Run {
      ack := req;
    }
  Run:
    to Run {
      ack := req;
    }
end
