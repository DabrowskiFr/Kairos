// BAD SPECIFICATION — the delayed output is required to equal the current input.
// The implementation correctly returns the sample captured one cycle earlier.
node delay_int(x: int) returns (y: int)
contracts
  ensures: X ( G (y =  x) );
locals
  z : int;
states
  Init(init), Run;
invariants
  in Run:
    z = prev x;
transitions
  Init:
    to Run  {
    z := x;
  }
  Run:
    to Run  {
    y := z;
    z := x;
  }
end
