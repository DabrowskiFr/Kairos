// BAD INVARIANT — Off is incorrectly described as leaving the light on.
// Initialisation and every transition to Off set light to 0, not 1.
node w_hold_until_off(on: int, off: int) returns (light: int)
contracts
  requires: G((on = 0 or on = 1) and (off = 0 or off = 1));
  ensures: X G((on = 1 and off = 0) => ((light = 1) W (off = 1)));
states
  Init(init), Off, On;
invariants
  in Off:
    light = 1;
  in On:
    light = 1;
transitions
  Init:
    to Off {
      light := 0;
    }
  Off:
    to On when on = 1 and off = 0 {
      light := 1;
    }
    to Off when not (on = 1 and off = 0) {
      skip;
    }
  On:
    to Off when off = 1 {
      light := 0;
    }
    to On when off = 0 {
      skip;
    }
end
