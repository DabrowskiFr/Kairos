// BAD CODE — should be rejected by the verifier.
// A normal credit/debit step resets bal to 0 instead of updating the balance.
// The result no longer agrees with the stored account history.
node credit_balance_monitor(reset: int, credit: int, debit: int) returns (bal: int)
contracts
  assume: G((reset = 0 or reset = 1) and (credit >= 0) and (debit >= 0));
  assume: G((reset = 1) => (credit = 0 and debit = 0));
  guarantee: G((reset = 1) => (bal = 0));
  guarantee: G(bal >= 0);
locals
  m : int;
states
  Init(init), Run;
invariants
  in Run:
    (m >= 0) and
    (m = prev bal);
transitions
  Init:
    to Run when reset = 1 {
      bal := 0;
      m := 0;
    }
    to Run when reset = 0 and debit <= credit {
      bal := credit - debit;
      m := credit - debit;
    }
    to Run when reset = 0 and debit > credit {
      bal := 0;
      m := 0;
    }
  Run:
    to Run when reset = 1 {
      bal := 0;
      m := 0;
    }
    to Run when reset = 0 and debit <= m + credit {
      bal := 0;
      m := m + credit - debit;
    }
end
