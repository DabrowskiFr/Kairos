// BAD SPECIFICATION — acknowledgement is required with the opposite polarity.
// While a request remains active, the implementation exposes ack = 1.
node w_ack_window(req: int) returns (ack: int)
contracts
  assume: G(req = 0 or req = 1);
  guarantee: X G((req = 1) => ((ack = 0) W (req = 0)));
states
  Init(init), Run;
transitions
  Init:
    to Run {
      ack := req;
    }
  Run:
    to Run {
      ack := req;
    }
end
