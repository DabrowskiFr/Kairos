// BAD INVARIANT — state B is documented with its active mode switched off.
// The A-to-B handoff assigns [modeB := 1], so preservation must fail.
node handoff() returns (modeA: int, modeB: int)
contracts
  ensures: G( {modeA} = {1} => X( {modeB} = {1} ) );
  ensures: G( {modeB} = {1} => X( {modeA} = {1} ) );
  ensures: G (G ( {modeA} = {1} => X( {modeB} = {1} ) ));
states
  Init(init), A, B;
invariants
  in A:
      modeA = 1;
      modeB = 0;
  in B:
      modeA = 0;
      modeB = 0;
transitions
  Init:
    to A {
      modeA := 1;
      modeB := 0;
    }
  A:
    to B  {
    modeA := 0;
    modeB := 1;
  }
  B:
    to A  {
    modeA := 1;
    modeB := 0;
  }
end
