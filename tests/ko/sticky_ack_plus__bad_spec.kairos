// BAD SPECIFICATION — acknowledgement is given the wrong polarity.
// Once req = 1 occurs, the latch keeps ack = 1 rather than ack = 0.
node sticky_ack_plus(req: int) returns (ack: int)
contracts
  requires: G (req = 0 or req = 1);
  ensures: G (req = 1 => G (ack = 0));
  ensures: G (ack = 1 => G (ack = 1));
states
  Init(init), Wait, Latched;
invariants
  in Wait:
    ack = 0;
  in Latched:
    ack = 1;
transitions
  Init:
    to Latched when req = 1 {
      ack := 1;
    }
    to Wait when req = 0 {
      ack := 0;
    }
  Wait:
    to Latched when req = 1 {
      ack := 1;
    }
    to Wait when req = 0 {
      ack := 0;
    }
  Latched:
    to Latched {
      ack := 1;
    }
end
