node derived_output_assignment(
  enable: bool
) returns (
  motorOn: bool
)

contracts

states Init(init), Idle, Running;
derive motorOn = state in Running;

transitions
  Init:
    to Running when enable = true {
      motorOn := true;
    }
    to Idle { skip; }

  Idle:
    to Idle { skip; }

  Running:
    to Running { skip; }
end
