// Scenario: a controller delegates signal filtering to a reusable node.
// Fault: the call stores its result in raw, which is an input of the caller.
node threshold_filter(sample: int) returns (accepted: bool)
contracts
states
  Init(init), Run;
transitions
  Init:
    to Run {
      accepted := false;
    }
  Run:
    to Run {
      accepted := sample > 10;
    }
end

node node_call_writes_input(raw: int) returns (filtered: bool)
contracts
states
  Init(init), Run;
transitions
  Init:
    to Run {
      filtered := false;
    }
  Run:
    to Run {
      call threshold_filter(raw) returns (raw);
    }
end
