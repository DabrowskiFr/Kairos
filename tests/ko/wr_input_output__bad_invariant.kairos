// BAD INVARIANT — Run is incorrectly assumed to keep the output asserted.
// A normal low-input step sets y to 0, contradicting the claimed y = 1.
node wr_input_output(x: int) returns (y: int)
contracts
  assume: G(x = 0 or x = 1);
  guarantee: X G((x = 1) => ((y = 1) W (x = 0)));
  guarantee: X G((x = 1) R (y = 0 or x = 1));
states
  Init(init), Run;
invariants
  in Run:
    y = 1;
transitions
  Init:
    to Run {
      y := x;
    }
  Run:
    to Run {
      y := x;
    }
end
