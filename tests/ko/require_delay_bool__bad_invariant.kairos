// BAD INVARIANT — the stored boolean sample is given the wrong polarity.
// The program copies [u] without inversion, so the relation cannot be preserved.
node require_delay_bool(u: int) returns (y: int)
contracts
  requires: G (u = 0 or u = 1);
  ensures: next always (y = prev u);
locals
  m: int;
states
  Init(init), Run;
invariants
  in Run:
    m = 1 - prev u;
transitions
  Init:
    to Run {
      y := u;
      m := u;
    }
  Run:
    to Run {
      y := m;
      m := u;
    }
end
