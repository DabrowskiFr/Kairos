// BAD INVARIANT — Wait is incorrectly described as already acknowledged.
// A transition to Wait sets ack to 0, so the claimed ack = 1 cannot hold.
node sticky_ack_plus(req: int) returns (ack: int)
contracts
  assume: G (req = 0 or req = 1);
  guarantee: G (req = 1 => G (ack = 1));
  guarantee: G (ack = 1 => G (ack = 1));
states
  Init(init), Wait, Latched;
invariants
  in Wait:
    ack = 1;
  in Latched:
    ack = 1;
transitions
  Init:
    to Latched when req = 1 {
      ack := 1;
    }
    to Wait when req = 0 {
      ack := 0;
    }
  Wait:
    to Latched when req = 1 {
      ack := 1;
    }
    to Wait when req = 0 {
      ack := 0;
    }
  Latched:
    to Latched {
      ack := 1;
    }
end
