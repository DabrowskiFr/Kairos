node binding_leaf(sample: int) returns (value: int)
contracts
states
  Init(init), Run;
transitions
  Init:
    to Run { value := sample; }
  Run:
    to Run { value := sample; }
end

node hierarchy_binding_changes(x: int, y: int) returns (value: int)
contracts
instances
  instance leaf: binding_leaf;
states
  Init(init), Run;
transitions
  Init:
    to Run { call leaf(x) returns (value); }
  Run:
    to Run { call leaf(y) returns (value); }
end
