// BAD SPECIFICATION — the delay is omitted after an ordinary running step.
// With no reset in either cycle, y is the preceding input rather than current x.
node resettable_delay(reset: int, x: int) returns (y: int)
contracts
  assume : G ((reset = 0 or reset = 1) and (reset = 1 => x = 0));
  guarantee  : G ((reset = 1) => (y = 0));
  guarantee  : X G ((reset = 0 and prev reset = 1) => y = 0);
  guarantee  : X G ((reset = 0 and prev reset = 0) => y = x);
locals
  m : int;
states
  Init(init), Run;
invariants
  in Run:
    (prev reset = 1 => m = 0) and (prev reset = 0 => m = prev x);
transitions
  Init:
    to Run when reset = 1 { y := 0; m := 0; }
    to Run when reset = 0 { y := 0; m := x; }
  Run:
    to Run when reset = 1 { y := 0; m := 0; }
    to Run when reset = 0 { y := m; m := x; }
end
  
