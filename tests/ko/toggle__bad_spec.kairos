// BAD SPECIFICATION — the initial phase of the alternating signal is reversed.
// Initialization emits y = 0, not y = 1.
node toggle() returns (y: int)
contracts
  guarantee: y = 1;
  guarantee: G ( y = 0 => X ( y = 1 ) );
  guarantee: G ( y = 1 => X ( y = 0 ) );
states
  Init(init), Run;
transitions
  Init:
    to Run  {
    y := 0;
  }
  Run:
    to Run  {
    y := 1 - y;
  }
end
