// BAD SPECIFICATION — the controller is required to skip the yellow phase.
// From green (color = 0), the implementation advances to yellow (color = 1).
node traffic3() returns (color: int)
contracts
  guarantee: G( color = 0 => X( color = 2 ) );
  guarantee: G( color = 1 => X( color = 2 ) );
  guarantee: G( color = 2 => X( color = 0 ) );
locals
states
  Init(init), Green, Yellow, Red;
invariants
  in Green:
    color = 0;
  in Yellow:
    color = 1;
  in Red:
    color = 2;
transitions
  Init:
    to Green {
      color := 0;
    }
  Green:
    to Yellow  {
    color := 1;
  }
  Yellow:
    to Red  {
    color := 2;
  }
  Red:
    to Green  {
    color := 0;
  }
end
