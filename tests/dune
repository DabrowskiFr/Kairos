(rule
 (alias runtest)
 (deps
  (source_tree ../lib)
  (source_tree ../packages)
  (source_tree ../bin)
  (source_tree ../vscode/src)
  ../vscode/package.json
  dune
  ../.github/workflows/architecture.yml
  ../.github/workflows/package-boundaries.yml
  (glob_files ../*.opam)
  ../scripts/check_architecture_fitness.py
  ../scripts/check_package_boundaries.sh
  ../scripts/check_why_backend_guardrail.py
  ../scripts/validate_ok_ko.sh
  ../scripts/validate_performance.sh
  check_c_codegen.sh
  check_elaboration_frontier.sh
  check_reference_stability.sh
  check_vstte_medical_examples.sh
  frontend/spec_past_formula_frontier.kairos
  ../examples/medical_infusion_light.kairos
  ../examples/evaluation/case_studies/medical_infusion_controller.kairos
  (glob_files ok/*.kairos)
  (glob_files ko/*.kairos)
  ko/expectations.tsv)
 (action
  (progn
   (run python3 ../scripts/check_architecture_fitness.py)
   (run python3 ../scripts/check_why_backend_guardrail.py)
   (run bash ./check_elaboration_frontier.sh %{exe:../bin/cli/kairos.exe})
   (run bash ./check_c_codegen.sh %{exe:../bin/cli/kairos.exe})
   (run bash ./check_reference_stability.sh %{exe:../bin/cli/kairos.exe})
   (run
    bash
    ../scripts/validate_ok_ko.sh
    --repo-root
    %{workspace_root}
    --cli
    %{exe:../bin/cli/kairos.exe}
    --frontend-only
    --jobs
    8
    --timeout-file
    10)
   (run
    bash
    ./check_vstte_medical_examples.sh
    %{exe:../bin/cli/kairos.exe}
    ../examples/medical_infusion_light.kairos
    ../examples/evaluation/case_studies/medical_infusion_controller.kairos))))

(rule
 (alias proof-regression)
 (deps
  ../scripts/validate_ok_ko.sh
  (glob_files ok/*.kairos)
  (glob_files ko/*.kairos)
  ko/expectations.tsv
  ../examples/evaluation/case_studies/medical_infusion_controller.kairos
  %{exe:../bin/cli/kairos.exe})
 (action
  (progn
   (run
    bash
    ../scripts/validate_ok_ko.sh
    --repo-root
    %{workspace_root}
    --cli
    %{exe:../bin/cli/kairos.exe}
    --jobs
    4
    --timeout-goal
    5
    --timeout-negative-goal
    1
    --timeout-file
    30)
   (run
    bash
    ../scripts/validate_ok_ko.sh
    --repo-root
    %{workspace_root}
    --cli
    %{exe:../bin/cli/kairos.exe}
    --single-ok
    ../examples/evaluation/case_studies/medical_infusion_controller.kairos
    --timeout-goal
    30
    --timeout-file
    120))))

(rule
 (alias performance-regression)
 (deps
  ../scripts/validate_performance.sh
  (glob_files ok/*.kairos)
  ../examples/medical_infusion_light.kairos
  ../examples/railway_interlocking.kairos
  %{exe:../bin/cli/kairos.exe})
 (action
  (run
   bash
   ../scripts/validate_performance.sh
   --repo-root
   %{workspace_root}
   --cli
   %{exe:../bin/cli/kairos.exe}
   --skip-build)))

(rule
 (alias strategy-regression)
 (deps
  ../scripts/validate_performance.sh
  ok/toggle.kairos
  ok/resettable_delay.kairos
  ok/platform_door_badge.kairos
  ok/independent_alarm_acknowledgement.kairos
  ../examples/medical_infusion_light.kairos
  %{exe:../bin/cli/kairos.exe})
 (action
  (run
   bash
   ../scripts/validate_performance.sh
   --repo-root
   %{workspace_root}
   --cli
   %{exe:../bin/cli/kairos.exe}
   --strategy-matrix
   --skip-build)))

(rule
 (alias performance-full-regression)
 (deps
  ../scripts/validate_performance.sh
  ../examples/evaluation/case_studies/medical_infusion_controller.kairos
  %{exe:../bin/cli/kairos.exe})
 (action
  (setenv
   KAIROS_PERFORMANCE_TIMEOUT_S
   30
   (run
    bash
    ../scripts/validate_performance.sh
    --repo-root
    %{workspace_root}
    --cli
    %{exe:../bin/cli/kairos.exe}
    --case
    medical-full
    --runs
    3
    --skip-build))))
