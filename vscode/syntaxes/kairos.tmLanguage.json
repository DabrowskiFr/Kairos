{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kairos",
  "scopeName": "source.kairos",
  "patterns": [
    { "include": "#comments" },
    { "include": "#typeDeclarations" },
    { "include": "#callableDeclarations" },
    { "include": "#specDeclarations" },
    { "include": "#nodeHeaders" },
    { "include": "#sectionKeywords" },
    { "include": "#stateLabels" },
    { "include": "#transitionTargets" },
    { "include": "#temporalOperators" },
    { "include": "#historyOperators" },
    { "include": "#quantifiers" },
    { "include": "#parameterModes" },
    { "include": "#controlKeywords" },
    { "include": "#declarationKeywords" },
    { "include": "#logicalKeywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#specialVariables" },
    { "include": "#functionCalls" },
    { "include": "#declarationNames" },
    { "include": "#enumConstructors" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kairos",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kairos",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "typeDeclarations": {
      "patterns": [
        {
          "name": "meta.type.declaration.kairos",
          "match": "^\\s*(type)\\s+([A-Za-z_][A-Za-z0-9_']*)\\s*(=)",
          "captures": {
            "1": { "name": "keyword.declaration.type.kairos" },
            "2": { "name": "entity.name.type.kairos" },
            "3": { "name": "keyword.operator.assignment.definition.kairos" }
          }
        }
      ]
    },
    "callableDeclarations": {
      "patterns": [
        {
          "name": "meta.callable.declaration.kairos",
          "match": "^\\s*(function|predicate|method)\\s+([A-Za-z_][A-Za-z0-9_']*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.function.kairos" },
            "2": { "name": "entity.name.function.kairos" }
          }
        }
      ]
    },
    "specDeclarations": {
      "patterns": [
        {
          "name": "meta.spec.declaration.kairos",
          "match": "^\\s*(spec)\\s+(def)\\s+([A-Za-z_][A-Za-z0-9_']*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.spec.kairos" },
            "2": { "name": "keyword.declaration.definition.kairos" },
            "3": { "name": "entity.name.function.kairos" }
          }
        }
      ]
    },
    "nodeHeaders": {
      "patterns": [
        {
          "name": "meta.node.header.kairos",
          "match": "^\\s*(node)\\s+([A-Za-z_][A-Za-z0-9_']*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.node.kairos" },
            "2": { "name": "entity.name.function.kairos" }
          }
        }
      ]
    },
    "sectionKeywords": {
      "patterns": [
        {
          "name": "keyword.control.section.kairos",
          "match": "^\\s*(?:contracts|locals|ghost|ghosts|observers|states|invariants|trans|transitions)\\b"
        },
        {
          "name": "keyword.control.contract.kairos",
          "match": "^\\s*(?:requires|ensures|assume|guarantee)\\b"
        },
        {
          "name": "keyword.control.annotation.kairos",
          "match": "^\\s*(?:invariant|variant)\\s*(?=:|\\bin\\b)"
        }
      ]
    },
    "stateLabels": {
      "patterns": [
        {
          "name": "meta.state.initial-transition.kairos",
          "match": "^\\s*(init)\\s*(:)(?=\\s*(?:to\\b|$))",
          "captures": {
            "1": { "name": "keyword.control.block.kairos" },
            "2": { "name": "punctuation.separator.kairos" }
          }
        },
        {
          "name": "meta.state.initializer.kairos",
          "match": "\\b([A-Za-z_][A-Za-z0-9_']*)\\s*(\\()\\s*(init)\\s*(\\))",
          "captures": {
            "1": { "name": "entity.name.type.state.kairos" },
            "2": { "name": "punctuation.parenthesis.open.kairos" },
            "3": { "name": "storage.modifier.initial.kairos" },
            "4": { "name": "punctuation.parenthesis.close.kairos" }
          }
        },
        {
          "name": "meta.state.label.kairos",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_']*)\\s*(:)(?=\\s*(?:to\\b|$))",
          "captures": {
            "1": { "name": "entity.name.type.state.kairos" },
            "2": { "name": "punctuation.separator.kairos" }
          }
        },
        {
          "name": "meta.invariant.selector.kairos",
          "match": "\\b(in)\\s+([A-Za-z_][A-Za-z0-9_']*)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.control.invariant.kairos" },
            "2": { "name": "entity.name.type.state.kairos" },
            "3": { "name": "punctuation.separator.kairos" }
          }
        }
      ]
    },
    "transitionTargets": {
      "patterns": [
        {
          "name": "meta.transition.source.kairos",
          "match": "\\b(from)\\s+([A-Za-z_][A-Za-z0-9_']*)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.control.transition.kairos" },
            "2": { "name": "entity.name.type.state.kairos" },
            "3": { "name": "punctuation.separator.kairos" }
          }
        },
        {
          "name": "meta.transition.target.kairos",
          "match": "\\b(to)\\s+([A-Za-z_][A-Za-z0-9_']*)\\b(?:\\s+(when)\\b)?",
          "captures": {
            "1": { "name": "keyword.control.transition.kairos" },
            "2": { "name": "entity.name.type.state.kairos" },
            "3": { "name": "keyword.control.condition.kairos" }
          }
        }
      ]
    },
    "temporalOperators": {
      "patterns": [
        {
          "name": "keyword.operator.temporal.kairos",
          "match": "\\b(?:G|X|W|R|always|next|weakuntil|release)\\b"
        }
      ]
    },
    "historyOperators": {
      "patterns": [
        {
          "name": "keyword.operator.history.kairos",
          "match": "\\b(?:pre|pre_k|past|old|prev[0-9]*)\\b"
        }
      ]
    },
    "quantifiers": {
      "patterns": [
        {
          "name": "keyword.control.quantifier.kairos",
          "match": "\\b(?:forall|exists)\\b"
        }
      ]
    },
    "parameterModes": {
      "patterns": [
        {
          "name": "storage.modifier.parameter.kairos",
          "match": "\\binout\\b"
        }
      ]
    },
    "controlKeywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.kairos",
          "match": "\\b(?:if|then|else|match|with|when)\\b"
        },
        {
          "name": "keyword.control.loop.kairos",
          "match": "\\b(?:while|do|for|variant)\\b"
        },
        {
          "name": "keyword.control.transition.kairos",
          "match": "\\b(?:from|to|skip)\\b"
        },
        {
          "name": "keyword.control.block.kairos",
          "match": "\\b(?:end|init|step)\\b"
        },
        {
          "name": "keyword.control.contract.kairos",
          "match": "\\b(?:requires|ensures|assume|guarantee|invariant|invariants|except)\\b"
        },
        {
          "name": "keyword.control.membership.kairos",
          "match": "\\bin\\b"
        }
      ]
    },
    "declarationKeywords": {
      "patterns": [
        {
          "name": "keyword.declaration.kairos",
          "match": "\\b(?:node|type|function|predicate|method|spec|def|let|locals|ghost|ghosts|observers|states|trans|transitions|contracts|returns)\\b"
        }
      ]
    },
    "logicalKeywords": {
      "patterns": [
        {
          "name": "keyword.control.logical.kairos",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.kairos",
          "match": "\\b(?:int|bool|real)\\b"
        },
        {
          "name": "storage.type.meta.kairos",
          "match": "\\b(?:Formula|formula|HExpr|hexpr|Nat|nat)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.kairos",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "specialVariables": {
      "patterns": [
        {
          "name": "variable.language.special.kairos",
          "match": "\\b(?:result|self|state)\\b"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "meta.function-call.kairos",
          "match": "\\b([A-Za-z_][A-Za-z0-9_']*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.kairos" }
          }
        }
      ]
    },
    "declarationNames": {
      "patterns": [
        {
          "name": "meta.variable.declaration.kairos",
          "match": "\\b([A-Za-z_][A-Za-z0-9_']*)\\b(?=\\s*(?:\\[[^\\]]*\\])?\\s*:)",
          "captures": {
            "1": { "name": "variable.other.definition.kairos" }
          }
        }
      ]
    },
    "enumConstructors": {
      "patterns": [
        {
          "name": "meta.match.wildcard.kairos",
          "match": "(^\\s*\\|\\s*)(_)(?=\\s*\\{)",
          "captures": {
            "2": { "name": "constant.language.wildcard.kairos" }
          }
        },
        {
          "name": "constant.language.enum.kairos",
          "match": "\\b[A-Z][A-Za-z0-9_']*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.kairos",
          "match": "(?<![A-Za-z0-9_'])(?:0|[1-9][0-9]*)(?![A-Za-z0-9_'])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.kairos",
          "match": ":="
        },
        {
          "name": "keyword.operator.flow.kairos",
          "match": "->"
        },
        {
          "name": "keyword.operator.logical.kairos",
          "match": "=>|>=|<=|!=|=|>|<"
        },
        {
          "name": "keyword.operator.arithmetic.kairos",
          "match": "[+\\-*/]"
        },
        {
          "name": "punctuation.separator.alternation.kairos",
          "match": "\\|"
        },
        {
          "name": "punctuation.definition.parameter.kairos",
          "match": "\\$"
        },
        {
          "name": "punctuation.separator.range.kairos",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.accessor.kairos",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.kairos",
          "match": "[:,;]"
        },
        {
          "name": "punctuation.bracket.kairos",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
