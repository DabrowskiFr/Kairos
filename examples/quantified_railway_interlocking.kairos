type Track = TA | TB | TC | TD | TE;
type Route = R_AB | R_AC | R_DE;
type Point = P1 | P2;
type SignalColor = Red | Green;
type PointPosition = Normal | Reverse;
type RouteState = Idle | Locked | Releasing;

function stopSignal(): SignalColor
  ensures: result = Red;
= Red;

function proceedSignal(): SignalColor
  ensures: result = Green;
= Green;

function idleState(): RouteState
  ensures: result = Idle;
= Idle;

function lockedState(): RouteState
  ensures: result = Locked;
= Locked;

function releasingState(): RouteState
  ensures: result = Releasing;
= Releasing;

function trackClear(isOccupied: bool): bool
  ensures: result = { isOccupied = false };
= isOccupied = false;

node quantified_railway_interlocking(
  occupied[Track]: bool,
  request[Route]: bool,
  cancel[Route]: bool,
  releaseAck[Route]: bool
) returns (
  signal[Route]: SignalColor,
  routeState[Route]: RouteState,
  reserved[Route]: bool,
  pointPosition[Point]: PointPosition
)

predicate routeIdle(r) =
  routeState[r] = Idle;

predicate routeLocked(r) =
  routeState[r] = Locked;

predicate signalRed(r) =
  signal[r] = Red;

predicate signalGreen(r) =
  signal[r] = Green;

predicate cancelRequested(r) =
  cancel[r] = true and routeState[r] != Idle;

predicate allRoutesIdle() =
  forall r in Route. routeIdle(r);

action clearRoute(r) {
  signal[r] := stopSignal();
  routeState[r] := idleState();
  reserved[r] := false;
}

action cancelRoute(r) {
  routeState[r] := releasingState();
  reserved[r] := true;
  signal[r] := stopSignal();
}

action lockRoute(r) {
  routeState[r] := lockedState();
  reserved[r] := true;
  signal[r] := proceedSignal();
}

contracts
  ensures: G(routeState[R_AB] = Locked => X(reserved[R_AB] = true W routeState[R_AB] = Idle));
  ensures: G(routeState[R_AC] = Locked => X(reserved[R_AC] = true W routeState[R_AC] = Idle));
  ensures: G(routeState[R_DE] = Locked => X(reserved[R_DE] = true W routeState[R_DE] = Idle));

  ensures: G(routeState[R_AB] = Locked =>
    X((routeState[R_AC] != Locked and pointPosition[P1] = Normal) W routeState[R_AB] = Idle));
  ensures: G(routeState[R_AC] = Locked =>
    X((routeState[R_AB] != Locked and routeState[R_DE] != Locked and pointPosition[P1] = Reverse)
      W routeState[R_AC] = Idle));
  ensures: G(routeState[R_DE] = Locked =>
    X((routeState[R_AC] != Locked and pointPosition[P2] = Normal) W routeState[R_DE] = Idle));

  ensures: G(signal[R_AB] = Green => occupied[TA] = false and occupied[TB] = false);
  ensures: G(signal[R_AC] = Green => occupied[TA] = false and occupied[TC] = false);
  ensures: G(signal[R_DE] = Green => occupied[TD] = false and occupied[TE] = false);

  ensures: forall r in Route.
    G(routeState[r] = Releasing => signalRed(r));
  ensures: forall r in Route.
    G(cancelRequested(r) => X(signalRed(r) W routeIdle(r)));
  ensures: forall r in Route.
    G(signalGreen(r) => routeLocked(r));

states Init(init), Run;

invariants
  in Run:
    forall r in Route. routeState[r] = Idle or routeState[r] = Locked or routeState[r] = Releasing;
    forall r in Route. routeState[r] != Idle => reserved[r] = true;
    forall r in Route. routeState[r] = Releasing => signalRed(r);
    routeState[R_AB] != Idle =>
      pointPosition[P1] = Normal
      and routeState[R_AC] != Locked;
    routeState[R_AC] != Idle =>
      pointPosition[P1] = Reverse
      and routeState[R_AB] != Locked
      and routeState[R_DE] != Locked;
    routeState[R_DE] != Idle =>
      pointPosition[P2] = Normal
      and routeState[R_AC] != Locked;

trans
  Init:
    to Run {
      for r in Route {
        clearRoute(r);
      }
      pointPosition[P1] := Normal;
      pointPosition[P2] := Normal;
    }

  Run:
    to Run {
      for r in Route {
        signal[r] := stopSignal();
      }

      if cancel[R_AB] and routeState[R_AB] != Idle then
        cancelRoute(R_AB);
      else
        skip;
      end;

      if cancel[R_AC] and routeState[R_AC] != Idle then
        cancelRoute(R_AC);
      else
        skip;
      end;

      if cancel[R_DE] and routeState[R_DE] != Idle then
        cancelRoute(R_DE);
      else
        skip;
      end;

      if request[R_AB] and not cancel[R_AB] and allRoutesIdle() and trackClear(occupied[TA]) and trackClear(occupied[TB]) then
        lockRoute(R_AB);
        pointPosition[P1] := Normal;
      else
        skip;
      end;

      if request[R_AC] and not cancel[R_AC] and allRoutesIdle() and trackClear(occupied[TA]) and trackClear(occupied[TC]) then
        lockRoute(R_AC);
        pointPosition[P1] := Reverse;
      else
        skip;
      end;

      if request[R_DE] and not cancel[R_DE] and allRoutesIdle() and trackClear(occupied[TD]) and trackClear(occupied[TE]) then
        lockRoute(R_DE);
        pointPosition[P2] := Normal;
      else
        skip;
      end;

      if not cancel[R_AB] and releaseAck[R_AB] and routeState[R_AB] = Releasing then
        clearRoute(R_AB);
      else
        skip;
      end;

      if not cancel[R_AC] and releaseAck[R_AC] and routeState[R_AC] = Releasing then
        clearRoute(R_AC);
      else
        skip;
      end;

      if not cancel[R_DE] and releaseAck[R_DE] and routeState[R_DE] = Releasing then
        clearRoute(R_DE);
      else
        skip;
      end;
    }
end
