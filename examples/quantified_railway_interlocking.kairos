type Track = TA | TB | TC | TD | TE;
type Route = R_AB | R_AC | R_DE;
type Point = P1 | P2;
type SignalColor = Red | Green;
type PointPosition = Normal | Reverse;
type RouteState = Idle | Locked | Releasing;

function stopSignal(): SignalColor
  ensures: result = Red;
= Red;

function proceedSignal(): SignalColor
  ensures: result = Green;
= Green;

function idleState(): RouteState
  ensures: result = Idle;
= Idle;

function lockedState(): RouteState
  ensures: result = Locked;
= Locked;

function releasingState(): RouteState
  ensures: result = Releasing;
= Releasing;

function isIdleState(s: RouteState): bool
  ensures: result = { s = Idle };
= s = Idle;

function isLockedState(s: RouteState): bool
  ensures: result = { s = Locked };
= s = Locked;

function isReleasingState(s: RouteState): bool
  ensures: result = { s = Releasing };
= s = Releasing;

function trackClear(isOccupied: bool): bool
  ensures: result = { isOccupied = false };
= isOccupied = false;

node quantified_railway_interlocking(
  occupied[Track]: bool,
  request[Route]: bool,
  cancel[Route]: bool,
  releaseAck[Route]: bool
) returns (
  signal[Route]: SignalColor,
  routeState[Route]: RouteState,
  reserved[Route]: bool,
  pointPosition[Point]: PointPosition
)

predicate routeIdle(r) =
  { isIdleState(routeState[r]) } = true;

predicate routeLocked(r) =
  { isLockedState(routeState[r]) } = true;

predicate signalRed(r) =
  signal[r] = Red;

predicate signalGreen(r) =
  signal[r] = Green;

predicate allRoutesIdle() =
  forall r in Route. routeIdle(r);

action clearRoute(r) {
  signal[r] := stopSignal();
  routeState[r] := idleState();
  reserved[r] := false;
}

action cancelRoute(r) {
  routeState[r] := releasingState();
  reserved[r] := true;
  signal[r] := stopSignal();
}

action lockRoute(r) {
  routeState[r] := lockedState();
  reserved[r] := true;
  signal[r] := proceedSignal();
}

contracts
  topology
    route R_AB uses TA, TB requires P1 = Normal;
    route R_AC uses TA, TC requires P1 = Reverse;
    route R_DE uses TD, TE requires P2 = Normal;
    conflict R_AB, R_AC;
    conflict R_AC, R_DE;
    routeSignal R_AB -> R_AB;
    routeSignal R_AC -> R_AC;
    routeSignal R_DE -> R_DE;
  end

  ensures: G(routeState[R_AB] = Locked => X(reserved[R_AB] = true W routeState[R_AB] = Idle));
  ensures: forall r in Route.
    G(routeState[r] = Releasing => signalRed(r));
  ensures: forall r in Route.
    G(signalGreen(r) => routeLocked(r));

states Init(init), Run;

invariants
  in Init:
    forall r in Route. signal[r] = Red;
    forall r in Route. routeIdle(r);
    forall r in Route. reserved[r] = false;
  in Run:
    forall r in Route. routeState[r] = Idle or routeState[r] = Locked or routeState[r] = Releasing;
    forall r in Route. routeState[r] != Idle => reserved[r] = true;
    forall r in Route. routeState[r] = Releasing => signalRed(r);
    routeState[R_AB] != Idle =>
      pointPosition[P1] = Normal
      and routeState[R_AC] != Locked;
    routeState[R_AC] != Idle =>
      pointPosition[P1] = Reverse
      and routeState[R_AB] != Locked;
    routeState[R_DE] != Idle =>
      pointPosition[P2] = Normal;

trans
  Init:
    to Run {
      for r in Route {
        clearRoute(r);
      }
      pointPosition[P1] := Normal;
      pointPosition[P2] := Normal;
    }

  Run:
    to Run {
      for r in Route {
        signal[r] := stopSignal();
      }

      if cancel[R_AB] and not isIdleState(routeState[R_AB]) then
        cancelRoute(R_AB);
      else
        if releaseAck[R_AB] and isReleasingState(routeState[R_AB]) then
          clearRoute(R_AB);
        else
          if cancel[R_AC] and not isIdleState(routeState[R_AC]) then
            cancelRoute(R_AC);
          else
            if releaseAck[R_AC] and isReleasingState(routeState[R_AC]) then
              clearRoute(R_AC);
            else
              if cancel[R_DE] and not isIdleState(routeState[R_DE]) then
                cancelRoute(R_DE);
              else
                if releaseAck[R_DE] and isReleasingState(routeState[R_DE]) then
                  clearRoute(R_DE);
                else
                  if request[R_AB] and allRoutesIdle() and trackClear(occupied[TA]) and trackClear(occupied[TB]) then
                    lockRoute(R_AB);
                    pointPosition[P1] := Normal;
                  else
                    if request[R_AC] and allRoutesIdle() and trackClear(occupied[TA]) and trackClear(occupied[TC]) then
                      lockRoute(R_AC);
                      pointPosition[P1] := Reverse;
                    else
                      if request[R_DE] and allRoutesIdle() and trackClear(occupied[TD]) and trackClear(occupied[TE]) then
                        lockRoute(R_DE);
                        pointPosition[P2] := Normal;
                      else
                        skip;
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    }
end
