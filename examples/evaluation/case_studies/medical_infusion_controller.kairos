// VSTTE evaluation case only. The running example in the paper remains
// examples/medical_infusion_light.kairos.
//
// Informal device model.
//
// Sources used to construct the pump model.
// [S1] FDA, "Infusion Pumps".
// [S2] FDA, "Examples of Reported Infusion Pump Problems".
// [S3] FDA, "Infusion Pump Software Safety Research".
// [S4] Open PCA Pump Requirements, version 1.0.0, 2020.
// [S5] UMN Critical Systems Group, GPCA project and model help file.
// Full URLs and the abstraction mapping are recorded in:
// medical_infusion_controller.sources.md.
//
// This controller is a small abstraction of a patient-controlled analgesia
// infusion pump, in the style of the FDA/UPenn GPCA and Open PCA examples
// [S3,S4,S5]. A PCA pump delivers a prescribed basal infusion and may deliver
// a bounded bolus dose when requested [S4,S5]. The bolus has explicit state:
// a remaining dose while delivery is active, followed by a lockout period
// during which a new bolus request is rejected. The pump must also prevent
// hazards: line occlusion, unsafe door/cassette setup, excessive programmed
// rate, excessive cumulative dose, excessive bolus delivery, and unexpected
// measured flow while the actuator is off [S1,S2,S4].
//
// The model deliberately keeps only the signals needed for a compact Kairos
// benchmark. The numeric constants below are abstract model limits, standing
// for prescription/drug-library bounds in the real requirements [S4,S5]:
//
// - maximum admitted rate: 120 model units;
// - maximum admitted cumulative dose: 1000 model units.
// - requested bolus dose: 30 model units.
// - post-bolus lockout: 3 controller ticks.
//
// Inputs.
// - requestInfuse: clinician request for basal infusion.
// - bolusRequest: patient or clinician request for bolus delivery.
// - stopRequest: operator or safety-interlock command to stop therapy.
// - occlusion: pressure/flow sensor reports a blocked line.
// - doorOpen: pump door or cassette is not closed and locked.
// - ack: operator acknowledges a latched alarm.
// - rate: nonnegative programmed rate sample for this tick.
// - delivered: nonnegative measured volume sampled over the controller tick.
//   A positive sample is admitted only when the sampled safety conditions allow
//   a delivery mode for this tick; otherwise it is treated as unexpected flow.
//
// Outputs.
// - motorOn: pump actuator is enabled.
// - bolusActive: the admitted delivery mode is bolus, not basal.
// - alarmLatched: a safety alarm is latched.
// - totalDose: displayed accumulated measured volume.
// - peakRate: displayed maximum admitted infusion rate.
// - bolusRemaining: remaining volume in the active bolus dose.
// - lockoutRemaining: controller ticks before another bolus can start.
//
// Safety mapping.
// - Occlusion and unsafe setup stop infusion and latch alarm [S1,S2,S4].
// - A programmed rate above the drug-library bound is alarmed [S2,S4,S5].
// - A cumulative dose that would exceed the bound is alarmed [S4].
// - A bolus cannot deliver beyond its requested dose [S4,S5].
// - After a bolus, lockout prevents another bolus request [S4,S5].
// - Positive measured flow without an admitted delivery decision models unsafe
//   free flow or residual uncommanded delivery [S2,S4].
// - stopRequest stops both basal and bolus delivery [S4].
// - After a stop, the controller spends one full tick idle before accepting
//   another therapy request. This prevents stale requests from restarting
//   infusion implicitly.
// - A latched alarm cannot run the motor until acknowledgement [S4].
// - Acknowledgement clears the alarm only when hazards disappear [S4].
// - A newly latched alarm is visible for at least one full tick before it can
//   be cleared; this separates hazard reporting from operator acknowledgement.
// - Clearing an alarm never restarts therapy in the same tick [S4].
// - bolusRequest has priority over basal infusion in this abstraction [S4].
// - requestInfuse admits basal infusion only under safe conditions [S4,S5].

// If a trigger holds now, the response must hold on the next state.
spec def responds_now_next(trigger: Formula, response: Formula) =
  G($trigger => X($response));

// Once triggered, hold weak-until a release condition.
spec def holds_until_release(
  trigger: Formula, hold: Formula, clear: Formula
) =
  G($trigger => ($hold W $clear));

// Abstract drug-library checks. These functions name prescription bounds used
// by predicates and contracts; the constants are model units, not clinical
// units.
function rateWithinLimit(r: int): bool
  ensures: result = { r <= 120 };
= r <= 120;

function doseWithinLimit(d: int): bool
  ensures: result = { d <= 1000 };
= d <= 1000;

// Node interface. Inputs are environment observations or operator requests.
// Outputs are controller decisions and display/audit values.
node medical_infusion_controller(
  requestInfuse: bool, bolusRequest: bool, stopRequest: bool,
  occlusion: bool, doorOpen: bool, ack: bool,
  rate: int, delivered: int
) returns (
  motorOn: bool, bolusActive: bool, alarmLatched: bool,
  totalDose: int, peakRate: int,
  bolusRemaining: int, lockoutRemaining: int
)
observers
  // Cumulative measured volume, regardless of whether delivery was admitted.
  measuredDose : int =
    delivered -> pre(measuredDose) + delivered;

  // Historical maximum rate while the motor is enabled. Samples observed with
  // motor off do not contribute to the admitted peak.
  admittedRatePeak : int =
    if motorOn = true then rate else 0 end ->
    if motorOn = true and rate > pre(admittedRatePeak) then
      rate
    else
      pre(admittedRatePeak)
    end;

  // Cumulative dose delivered in admitted basal mode.
  basalDose : int =
    if motorOn = true and bolusActive = false then delivered else 0 end ->
    if pre(motorOn) = true and pre(bolusActive) = false then
      pre(basalDose) + delivered
    else
      pre(basalDose)
    end;

  // Cumulative dose delivered in admitted bolus mode.
  bolusDose : int =
    if motorOn = true and bolusActive = true then delivered else 0 end ->
    if pre(motorOn) = true and pre(bolusActive) = true then
      pre(bolusDose) + delivered
    else
      pre(bolusDose)
    end;

  // Cumulative measured volume from intervals whose entry command disabled
  // delivery.  The current sample belongs to the preceding physical interval.
  freeFlowDose : int =
    if motorOn = false and delivered > 0 then delivered else 0 end ->
    if pre(motorOn) = false and delivered > 0 then
      pre(freeFlowDose) + delivered
    else
      pre(freeFlowDose)
    end;

// Physical hazard reported by a pair of sensor samples.
predicate hazardActive(
  occlusionSample: bool, doorOpenSample: bool
) =
  occlusionSample = true or doorOpenSample = true;

// Drug-library rate check.
predicate rateUnsafe(rateSample: int) =
  not rateWithinLimit(rateSample);

// Bolus start is unsafe if the first delivered sample would exceed the
// prescribed bolus dose.
predicate initialBolusDoseUnsafe() =
  bolusRequest = true and delivered > 30;

// Dose projection shared by current, tick-entry, and previous-state views.
predicate doseWouldExceed(total: int, sample: int) =
  total + sample > 1000;

// Active bolus cannot consume more than its remaining prescribed dose.
predicate bolusDeliveryWouldExceed(
  active: bool, sample: int, remaining: int
) =
  active = true and sample > remaining;

// Initialization admission condition, where there is no previous alarm latch
// and the first delivered sample is checked directly.
predicate initiallySafeToRun() =
  not hazardActive(occlusion, doorOpen) and stopRequest = false
  and rateWithinLimit(rate) and doseWithinLimit(delivered)
  and not initialBolusDoseUnsafe();

predicate initiallyBolusCanStart() =
  initiallySafeToRun() and bolusRequest = true
  and delivered <= 30;

predicate initiallyBasalCanStart() =
  initiallySafeToRun() and bolusRequest = false
  and requestInfuse = true;

// Stable-state admission condition for any therapy mode.
predicate safeToRun() =
  not hazardActive(occlusion, doorOpen) and stopRequest = false
  and alarmLatched = false and rateWithinLimit(rate)
  and not doseWouldExceed(totalDose, delivered)
  and not bolusDeliveryWouldExceed(
    bolusActive, delivered, bolusRemaining
  )
  and (motorOn = true or delivered = 0);

// Therapy selected for this tick. Active bolus delivery continues until its
// remaining dose is consumed; lockout blocks new boluses but can allow basal.
predicate therapySelected() =
  (bolusActive = true and bolusRemaining > 0)
  or (requestInfuse = true
      and (bolusRequest = false or lockoutRemaining > 0))
  or (bolusRequest = true and lockoutRemaining = 0
      and delivered <= 30);

// Stable-state alarm causes.
predicate alarmCondition() =
  hazardActive(occlusion, doorOpen) or rateUnsafe(rate)
  or doseWouldExceed(totalDose, delivered)
  or bolusDeliveryWouldExceed(bolusActive, delivered, bolusRemaining)
  // A stop sampled now does not invalidate delivery measured over the
  // preceding interval while the actuator was still enabled.
  or (delivered > 0 and motorOn = false);

// Specification views at the current tick. Inputs are current; persistent
// controller values are read through pre. The one-use delivery-admission
// chain is kept local instead of being split over three predicates.
predicate alarmConditionAtTickEntry() =
  hazardActive(occlusion, doorOpen) or rateUnsafe(rate)
  or doseWouldExceed(pre(totalDose), delivered)
  or bolusDeliveryWouldExceed(
    pre(bolusActive), delivered, pre(bolusRemaining)
  )
  or (delivered > 0 and pre(motorOn) = false);

predicate alarmClearAllowedAtTickEntry() =
  ack = true and not alarmConditionAtTickEntry();

// Initialization alarm causes. This differs from `alarmCondition` because
// there is not yet a meaningful previous cumulative dose.
predicate initialAlarmCondition() =
  hazardActive(occlusion, doorOpen) or rateUnsafe(rate)
  or not doseWithinLimit(delivered)
  or initialBolusDoseUnsafe()
  or (
    delivered > 0
    and not (
      initiallyBolusCanStart() or initiallyBasalCanStart()
    )
  );

predicate bolusCanStart() =
  safeToRun() and bolusRequest = true
  and bolusActive = false
  and lockoutRemaining = 0
  and delivered <= 30;

predicate basalCanRun() =
  safeToRun() and bolusRequest = false
  and bolusActive = false
  and requestInfuse = true;

// A therapy request is accepted only if the previous tick was already clear
// and was not an operator stop. This is a specification predicate, not an
// executable transition guard.
predicate therapyAdmissionAllowed() =
  pre(alarmLatched) = false and pre(stopRequest) = false;

predicate bolusAdmitted() =
  not alarmConditionAtTickEntry()
  and stopRequest = false
  and pre(alarmLatched) = false and pre(stopRequest) = false
  and bolusRequest = true and pre(bolusActive) = false
  and pre(lockoutRemaining) = 0 and delivered <= 30;
predicate basalAdmitted() =
  basalCanRun() and therapyAdmissionAllowed();
predicate noDeliveryAdmitted() =
  safeToRun() and bolusRequest = false
  and bolusActive = false
  and requestInfuse = false and lockoutRemaining = 0
  and therapyAdmissionAllowed();

// Alarm clearing requires an acknowledgement and no active modeled alarm cause.
predicate alarmClearAllowed() =
  ack = true and not alarmCondition();

// Previous-tick alarm-clear view.
predicate previousAlarmCondition() =
  hazardActive(pre(occlusion), pre(doorOpen))
  or rateUnsafe(pre(rate))
  or doseWouldExceed(pre(totalDose), pre(delivered))
  or bolusDeliveryWouldExceed(
    pre(bolusActive), pre(delivered), pre(bolusRemaining)
  )
  or (pre(delivered) > 0 and pre(motorOn) = false);

// Methods update data shared by transitions after their explicit mode outputs.
method initDisplays()
contracts
  ensures: totalDose = delivered;
  ensures: motorOn = true => peakRate = rate;
  ensures: motorOn = false => peakRate = 0;
{
  totalDose := delivered;
  if motorOn = true then
    peakRate := rate;
  else
    peakRate := 0;
  end;
}

// Stable-tick dose and peak-rate update shared by all stable transitions.
method finishTick()
contracts
  ensures: totalDose = old(totalDose) + delivered;
  ensures: motorOn = true and rate > old(peakRate) => peakRate = rate;
  ensures: not (motorOn = true and rate > old(peakRate)) =>
    peakRate = old(peakRate);
{
  totalDose := totalDose + delivered;
  if motorOn = true and rate > peakRate then
    peakRate := rate;
  else
    peakRate := peakRate;
  end;
}

method clearBolusAndTickLockout()
contracts
  ensures: bolusRemaining = 0;
  ensures: old(lockoutRemaining) > 0 =>
    lockoutRemaining = old(lockoutRemaining) - 1;
  ensures: old(lockoutRemaining) <= 0 => lockoutRemaining = 0;
{
  bolusRemaining := 0;
  if lockoutRemaining > 0 then
    lockoutRemaining := lockoutRemaining - 1;
  else
    lockoutRemaining := 0;
  end;
}

method initializeWithBolus(bolusRemainingNext: int)
contracts
  ensures: bolusRemaining = bolusRemainingNext;
  ensures: lockoutRemaining = 0;
  ensures: totalDose = delivered;
  ensures: motorOn = true => peakRate = rate;
  ensures: motorOn = false => peakRate = 0;
{
  bolusRemaining := bolusRemainingNext;
  lockoutRemaining := 0;
  initDisplays();
}

method finishTickWith(
  bolusRemainingNext: int, lockoutRemainingNext: int
)
contracts
  ensures: bolusRemaining = bolusRemainingNext;
  ensures: lockoutRemaining = lockoutRemainingNext;
  ensures: totalDose = old(totalDose) + delivered;
  ensures: motorOn = true and rate > old(peakRate) => peakRate = rate;
  ensures: not (motorOn = true and rate > old(peakRate)) =>
    peakRate = old(peakRate);
{
  bolusRemaining := bolusRemainingNext;
  lockoutRemaining := lockoutRemainingNext;
  finishTick();
}

method finishSuppressedTick()
contracts
  ensures: bolusRemaining = 0;
  ensures: old(lockoutRemaining) > 0 =>
    lockoutRemaining = old(lockoutRemaining) - 1;
  ensures: old(lockoutRemaining) <= 0 => lockoutRemaining = 0;
  ensures: totalDose = old(totalDose) + delivered;
  ensures: motorOn = true and rate > old(peakRate) => peakRate = rate;
  ensures: not (motorOn = true and rate > old(peakRate)) =>
    peakRate = old(peakRate);
{
  clearBolusAndTickLockout();
  finishTick();
}

contracts
  // Environmental assumptions on numeric input samples.
  assume: G(rate >= 0);
  assume: G(delivered >= 0);

  // Public safety responses.
  guarantee: responds_now_next(
    [hazardActive(occlusion, doorOpen)],
    [alarmLatched = true and motorOn = false]);
  guarantee: responds_now_next(
    [rateUnsafe(rate)], [alarmLatched = true and motorOn = false]);
  guarantee: responds_now_next(
    [doseWouldExceed(pre(totalDose), delivered)],
    [alarmLatched = true and motorOn = false]);
  guarantee: responds_now_next(
    [bolusDeliveryWouldExceed(
      pre(bolusActive), delivered, pre(bolusRemaining)
    )],
    [alarmLatched = true and motorOn = false]);
  guarantee: responds_now_next(
    [stopRequest = true], [motorOn = false and bolusActive = false]);
  guarantee: G(alarmLatched = true => motorOn = false);
  guarantee: holds_until_release(
    [alarmLatched = true and ack = false],
    [alarmLatched = true and motorOn = false],
    [alarmClearAllowedAtTickEntry()]);
  guarantee: X G(
    pre(alarmLatched) = true and not previousAlarmCondition()
    and alarmClearAllowedAtTickEntry()
    => alarmLatched = false and motorOn = false
       and bolusActive = false);
  guarantee: G(lockoutRemaining > 0 => bolusActive = false);
  guarantee: X G(
    pre(bolusActive) = true and pre(bolusRemaining) > 0
    and delivered = pre(bolusRemaining)
    and not alarmConditionAtTickEntry()
    => lockoutRemaining > 0 and bolusActive = false);
  guarantee: G(motorOn = true => measuredDose <= 1000);
  guarantee: G(motorOn = true => admittedRatePeak <= 120);
  guarantee: G(
    freeFlowDose > pre(freeFlowDose)
    => alarmLatched = true and motorOn = false);

  // Therapy admission discipline.
  guarantee: G(
    bolusAdmitted() =>
    motorOn = true and bolusActive = true and alarmLatched = false);
  guarantee: G(
    basalAdmitted() =>
    motorOn = true and bolusActive = false and alarmLatched = false);
  guarantee: G(
    noDeliveryAdmitted() =>
    motorOn = false and bolusActive = false and alarmLatched = false);
  guarantee: G(bolusActive = true => motorOn = true);

  // Audit and display consistency.
  guarantee: G(totalDose = measuredDose);
  guarantee: G(measuredDose = basalDose + bolusDose + freeFlowDose);
  guarantee: G(peakRate = admittedRatePeak);
  guarantee: G(motorOn = true => admittedRatePeak >= rate);
states
  Idle, BasalInfusing, BolusDelivering,
  BolusLockoutIdle, BolusLockoutBasal,
  StopHold, AlarmResponse, AlarmLatched;
invariants
  // State invariants record the mode outputs assigned by every transition.
  in {BasalInfusing, BolusDelivering, BolusLockoutBasal}:
    motorOn = true;
  in states except {BasalInfusing, BolusDelivering, BolusLockoutBasal}:
    motorOn = false;
  in BolusDelivering:
    bolusActive = true;
  in states except {BolusDelivering}:
    bolusActive = false;
  in {AlarmResponse, AlarmLatched}:
    alarmLatched = true;
  in states except {AlarmResponse, AlarmLatched}:
    alarmLatched = false;
  in states:
    totalDose = measuredDose; peakRate = admittedRatePeak;
    measuredDose = basalDose + bolusDose + freeFlowDose;
    basalDose <= measuredDose; bolusDose <= measuredDose;
    freeFlowDose <= measuredDose;
    totalDose >= 0; peakRate >= 0; peakRate <= 120;
    bolusRemaining >= 0; lockoutRemaining >= 0; lockoutRemaining <= 3;
  in {BasalInfusing, BolusDelivering, BolusLockoutBasal}:
    totalDose <= 1000;
  in BolusDelivering:
    bolusRemaining <= 30;
    lockoutRemaining = 0;
  in states except {BolusDelivering}:
    bolusRemaining = 0;
  in {BolusLockoutIdle, BolusLockoutBasal}:
    lockoutRemaining > 0;
  in {Idle, BasalInfusing, BolusDelivering}:
    lockoutRemaining = 0;
transitions
  // Initialization chooses the first mode. Startup free flow is treated as an
  // alarm condition rather than accepted as ordinary delivery.
  init:
    to AlarmResponse when initialAlarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      initializeWithBolus(0);
    }
    to StopHold when stopRequest = true {
      motorOn, bolusActive, alarmLatched := false, false, false;
      initializeWithBolus(0);
    }
    to BolusDelivering when initiallyBolusCanStart() {
      motorOn, bolusActive, alarmLatched := true, true, false;
      initializeWithBolus(30 - delivered);
    }
    to BasalInfusing when initiallyBasalCanStart() {
      motorOn, bolusActive, alarmLatched := true, false, false;
      initializeWithBolus(0);
    }
    to Idle {
      motorOn, bolusActive, alarmLatched := false, false, false;
      initializeWithBolus(0);
    }

  // Therapy states use the same priority order: safety alarm, explicit stop,
  // bolus start, basal admission, then idle.
  Idle:
    to AlarmResponse when alarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
    to StopHold when stopRequest = true {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishSuppressedTick();
    }
    to BolusDelivering when bolusCanStart() {
      motorOn, bolusActive, alarmLatched := true, true, false;
      finishTickWith(30 - delivered, 0);
    }
    to BasalInfusing when basalCanRun() {
      motorOn, bolusActive, alarmLatched := true, false, false;
      finishTickWith(0, 0);
    }
    to Idle {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, 0);
    }

  BasalInfusing:
    to AlarmResponse when alarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
    to StopHold when stopRequest = true {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishSuppressedTick();
    }
    to BolusDelivering when bolusCanStart() {
      motorOn, bolusActive, alarmLatched := true, true, false;
      finishTickWith(30 - delivered, 0);
    }
    to BasalInfusing when basalCanRun() {
      motorOn, bolusActive, alarmLatched := true, false, false;
      finishTickWith(0, 0);
    }
    to Idle {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, 0);
    }

  // Bolus delivery has real memory. The sample that consumes the remainder
  // enters lockout immediately, avoiding one extra enabled bolus interval.
  BolusDelivering:
    to AlarmResponse when alarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
    to StopHold when stopRequest = true {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, 3);
    }
    to BolusLockoutBasal
      when bolusRemaining = delivered and requestInfuse = true {
      motorOn, bolusActive, alarmLatched := true, false, false;
      finishTickWith(0, 3);
    }
    to BolusLockoutIdle when bolusRemaining = delivered {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, 3);
    }
    to BolusDelivering {
      motorOn, bolusActive, alarmLatched := true, true, false;
      finishTickWith(bolusRemaining - delivered, 0);
    }

  // During lockout, basal therapy may continue but bolus requests are ignored.
  BolusLockoutIdle:
    to AlarmResponse when alarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
    to StopHold when stopRequest = true {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishSuppressedTick();
    }
    to BolusLockoutBasal
      when lockoutRemaining > 1 and requestInfuse = true {
      motorOn, bolusActive, alarmLatched := true, false, false;
      finishTickWith(0, lockoutRemaining - 1);
    }
    to BolusLockoutIdle when lockoutRemaining > 1 {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, lockoutRemaining - 1);
    }
    to BasalInfusing
      when lockoutRemaining = 1 and requestInfuse = true {
      motorOn, bolusActive, alarmLatched := true, false, false;
      finishTickWith(0, 0);
    }
    to Idle {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, 0);
    }

  BolusLockoutBasal:
    to AlarmResponse when alarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
    to StopHold when stopRequest = true {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishSuppressedTick();
    }
    to BolusLockoutBasal
      when lockoutRemaining > 1 and requestInfuse = true {
      motorOn, bolusActive, alarmLatched := true, false, false;
      finishTickWith(0, lockoutRemaining - 1);
    }
    to BolusLockoutIdle when lockoutRemaining > 1 {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, lockoutRemaining - 1);
    }
    to BasalInfusing
      when lockoutRemaining = 1 and requestInfuse = true {
      motorOn, bolusActive, alarmLatched := true, false, false;
      finishTickWith(0, 0);
    }
    to Idle {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, 0);
    }

  // StopHold materializes the mandatory stopped tick after stopRequest. It can
  // let an existing bolus lockout continue, but cannot start therapy.
  StopHold:
    to AlarmResponse when alarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
    to StopHold when stopRequest = true {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishSuppressedTick();
    }
    to BolusLockoutIdle when lockoutRemaining > 1 {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, lockoutRemaining - 1);
    }
    to Idle {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, 0);
    }

  // AlarmResponse materializes the mandatory alarm response. It cannot clear
  // immediately, even if acknowledgement is already present.
  AlarmResponse:
    to AlarmResponse when alarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
    to AlarmLatched {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }

  // AlarmLatched is sticky until acknowledgement and disappearance of causes.
  // Clearing never restarts therapy in the same tick.
  AlarmLatched:
    to AlarmResponse when alarmCondition() {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
    to StopHold when alarmClearAllowed() and stopRequest = true {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishSuppressedTick();
    }
    to BolusLockoutIdle
      when alarmClearAllowed() and lockoutRemaining > 1 {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, lockoutRemaining - 1);
    }
    to Idle when alarmClearAllowed() {
      motorOn, bolusActive, alarmLatched := false, false, false;
      finishTickWith(0, 0);
    }
    to AlarmLatched {
      motorOn, bolusActive, alarmLatched := false, false, true;
      finishSuppressedTick();
    }
end
