type Client = C1 | C2 | C3 | C4;
type Resource = CPU | BUS | IO;
type LeaseState = Free | Granted | Releasing;

predicate resourceFree(r) =
  forall c in Client. holds[c, r] = false;

predicate resourceExclusive(r) =
  forall c1 in Client. forall c2 in Client.
    not (holds[c1, r] = true and holds[c2, r] = true) or c1 = c2;

predicate allResourcesExclusive() =
  forall r in Resource. resourceExclusive(r);

predicate releaseRequested(c, r) =
  releaseReq[c, r] = true;

node discrete_resource_allocator(
  request[Client * Resource]: bool,
  releaseReq[Client * Resource]: bool
) returns (
  holds[Client * Resource]: bool,
  leaseState[Client * Resource]: LeaseState,
  grantAge[Client * Resource]: int,
  resourceBusy[Resource]: bool
)
contracts
  ensures: G(allResourcesExclusive());
  ensures: forall c in Client. forall r in Resource.
    G(holds[c, r] = true =>
      X((holds[c, r] = true and resourceExclusive(r)) W releaseRequested(c, r)));

states Init(init), Run;

trans
  Init:
    to Run {
      for c in Client {
        for r in Resource {
          holds[c, r] := false;
          leaseState[c, r] := Free;
          grantAge[c, r] := 0;
        }
      }
      for r in Resource {
        resourceBusy[r] := false;
      }
    }

  Run:
    to Run {
      for c in Client {
        for r in Resource {
          if releaseReq[c, r] then
            holds[c, r] := false;
            leaseState[c, r] := Releasing;
            grantAge[c, r] := 0;
          else
            if holds[c, r] then
              grantAge[c, r] := grantAge[c, r] + 1;
            else
              skip;
            end;
          end;
        }
      }

      for c in Client {
        for r in Resource {
          if request[c, r] and resourceFree(r) then
            holds[c, r] := true;
            leaseState[c, r] := Granted;
            grantAge[c, r] := 0;
          else
            skip;
          end;
        }
      }

      for r in Resource {
        resourceBusy[r] := not resourceFree(r);
      }
    }
end
