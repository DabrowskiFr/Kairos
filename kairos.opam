opam-version: "2.0"
name: "kairos"
version: "dev"
synopsis: "Kairos semantic verification core"
description: "Kairos domain, reference verification, application interfaces, language frontend, neutral IRs, and Rocq development."
depends: [
  "dune" {>= "3.10"}
  "rocq-prover"
  "menhir"
  "ppx_deriving"
  "ppx_deriving_yojson"
  "ocaml"
  "yojson"
  "fmt"
  "logs"
  "sedlex"
]
build: [
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
install: [
  ["dune" "install" "-p" name "--create-install-files" "--prefix" prefix "--libdir" lib]
]
