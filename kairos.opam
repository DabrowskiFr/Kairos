opam-version: "2.0"
name: "kairos"
version: "dev"
maintainer: "Frédéric Dabrowski <frederic.dabrowski@univ-orleans.fr>"
authors: ["Frédéric Dabrowski"]
license: "GPL-3.0-or-later"
homepage: "https://github.com/DabrowskiFr/Kairos"
bug-reports: "https://github.com/DabrowskiFr/Kairos/issues"
dev-repo: "git+https://github.com/DabrowskiFr/Kairos.git"
synopsis: "Kairos semantic verification core"
description: "Kairos domain, reference verification, application interfaces, language frontend, and Rocq development."
depends: [
  "dune" {>= "3.10"}
  "rocq-prover"
  "menhir"
  "ppx_deriving"
  "ppx_deriving_yojson"
  "ocaml"
  "yojson"
  "fmt"
  "logs"
  "sedlex"
]
build: [
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
install: [
  ["dune" "install" "-p" name "--create-install-files" "--prefix" prefix "--libdir" lib]
]
