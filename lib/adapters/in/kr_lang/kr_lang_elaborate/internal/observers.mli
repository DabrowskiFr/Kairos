(** Observer elaboration helpers.

    Observers are proof-only variables generated by the front-end. This module
    only builds their declarations and transition updates; validity checks live
    in [Validation].
*)

val observer_raw_vdecl : Kr_lang_surface.Kr_lang_surface_ast.observer_decl -> Kr_lang_surface.Kr_lang_surface_syntax.raw_vdecl
(** Turn an observer declaration into the proof-only variable that stores its
    value. *)

type schedule
(** Dependency-respecting execution orders for observer initialization and
    ordinary steps. *)

val schedule :
  predicates:Kr_lang_surface.Kr_lang_surface_ast.predicate_decl list ->
  Kr_lang_surface.Kr_lang_surface_ast.observer_decl list ->
  schedule
(** Compute stable topological orders from direct references and references
    captured by predicates; reject instantaneous dependency cycles. *)

val observer_updates_for_transition :
  init_state:string ->
  schedule ->
  Kr_lang_surface.Kr_lang_surface_ast.transition ->
  Kr_lang_surface.Kr_lang_surface_ast.stmt list
(** Select and order observer updates for a transition: initialization updates
    when leaving the initial state, step updates otherwise. *)

val observer_locals : Kr_lang_surface.Kr_lang_surface_ast.observer_decl list -> Kr_lang_surface.Kr_lang_surface_syntax.raw_vdecl list
(** Generate the proof-only local declarations associated with observers. *)
