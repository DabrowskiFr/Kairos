(** Generation of Why3 contracts from product-step clauses.

    Translates Kairos transition requires/ensures into per-product-step
    contracts for helper functions generated by {!Why_compile}. Labels are kept
    next to the terms they describe so the Why3 text/proof-task presentation is
    owned by each generated helper module. *)
open Core_syntax

type step_contract_info = {
  step : Why_runtime_view.runtime_product_transition_view;
      (** The product transition this contract was derived from. *)
  pre : Why3.Ptree.term list;  (** Preconditions specific to this step. *)
  pre_labels : string list;  (** Labels aligned with [pre]. *)
  post : Why3.Ptree.term list;  (** Postconditions specific to this step. *)
  post_labels : string list;  (** Labels aligned with [post]. *)
  local_cuts : Why3.Ptree.term list;
      (** Helper-local assertions inserted after the step body. *)
  forbidden : Why3.Ptree.term list;
      (** Formulas whose violation is intentionally tolerated at this step. *)
  forbidden_labels : string list;  (** Labels aligned with [forbidden]. *)
}
(** Contract associated with one product transition in relational mode. *)

type contract_info = {
  step_contracts : step_contract_info list;
      (** Per-step contracts for the product. *)
}
(** Full contract generation result for a node. *)

val build_contracts :
  abstract_formula:(in_post:bool -> hexpr -> Why3.Ptree.term option) ->
  local_cut_candidate:(hexpr -> bool) ->
  env:Why_compile_expr.env ->
  runtime:Why_runtime_view.t ->
  simplify_formulas:bool ->
  deduplicate_terms:bool ->
  contract_info
(** [build_contracts ~env ~runtime] generates product-step contracts for the
    node described by [runtime].

    - [~abstract_formula]: optionally replaces a formula by a backend-level
      abstraction, such as a generated shared predicate.
    - [~local_cut_candidate]: identifies postcondition facts whose unfolded form
      should be asserted inside product-step helpers.
    - [~env]: compilation environment for the node.
    - [~simplify_formulas]: when [true], applies cheap syntactic FO
      simplifications before Why3 term generation.
    - [~deduplicate_terms]: when [true], removes syntactically duplicate
      contract terms. *)
