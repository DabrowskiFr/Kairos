digraph {
  compound=true
  graph [fontname="Arial", rankdir=TB, ranksep=1.0, nodesep=1.0]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">Dynamic View: Kairos</font>>

  subgraph cluster_7 {
    margin=25
    label=<<font point-size="24"><br />Kairos</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    10 [id=10,shape=rect, label=<<font point-size="34">Concrete engine</font><br /><font point-size="19">[Container: OCaml / kairos-engine-runtime]</font><br /><br /><font point-size="24">Public Kairos_engine.Api,<br />private Engine_flow, canonical<br />Pipeline_types contract,<br />focused runtime services, and<br />Kairos-specific output<br />coordination.</font>>, style=filled, color="#7d3a06", fillcolor="#b45309", fontcolor="#ffffff"]
    19 [id=19,shape=rect, label=<<font point-size="34">Kairos frontend</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Parses the surface language<br />and elaborates it to the core<br />verification model.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
    20 [id=20,shape=rect, label=<<font point-size="34">Domain core</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Core syntax, verification<br />model, shared IR, temporal<br />layout, and formula utilities.</font>>, style=filled, color="#0f4624", fillcolor="#166534", fontcolor="#ffffff"]
    21 [id=21,shape=rect, label=<<font point-size="34">Reference<br />verification kernel</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Validates supplied automata<br />normal form, then builds<br />product summaries and<br />reference proof obligations<br />from the core model.</font>>, style=filled, color="#0f4624", fillcolor="#166534", fontcolor="#ffffff"]
    29 [id=29,shape=rect, label=<<font point-size="34">Why3 backend</font><br /><font point-size="19">[Container: OCaml / Why3]</font><br /><br /><font point-size="24">Projects proof obligations to<br />Why3, performs backend-only<br />representation choices, and<br />calls proof services.</font>>, style=filled, color="#850c2a", fillcolor="#be123c", fontcolor="#ffffff"]
    32 [id=32,shape=rect, label=<<font point-size="34">External tool<br />adapters</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Narrow Automata_exchange and<br />Proof_backend_contract<br />boundaries for Spot, Why3, Z3,<br />and timing services.</font>>, style=filled, color="#4a4f59", fillcolor="#6b7280", fontcolor="#ffffff"]
    8 [id=8,shape=rect, label=<<font point-size="34">CLI</font><br /><font point-size="19">[Container: OCaml / Cmdliner]</font><br /><br /><font point-size="24">Command-line entry point for<br />checking, dumping, and proving<br />Kairos programs.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
  }

  1 [id=1,shape=rect, label=<<font point-size="34">Kairos developer</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Develops Kairos programs, runs<br />proofs, inspects artifacts,<br />and keeps the Rocq<br />formalization aligned.</font>>, style=filled, color="#0f3645", fillcolor="#164e63", fontcolor="#ffffff"]
  3 [id=3,shape=rect, label=<<font point-size="34">Spot</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External tool used to<br />construct temporal-property<br />automata.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  4 [id=4,shape=rect, label=<<font point-size="34">Why3</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External VC generation and<br />proof-task infrastructure.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  5 [id=5,shape=rect, label=<<font point-size="34">Z3</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External SMT solver used<br />through Why3 and selected<br />internal experiments.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]

  1 -> 8 [id=33, label=<<font point-size="24">1. runs --prove</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  8 -> 10 [id=36, label=<<font point-size="24">2. invokes public API and<br />canonical contract</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 19 [id=38, label=<<font point-size="24">3. parses and elaborates<br />through Engine_flow</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  19 -> 20 [id=40, label=<<font point-size="24">4. produces core model</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 32 [id=45, label=<<font point-size="24">5. produces supplied<br />automata through Spot<br />adapter</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  32 -> 3 [id=56, label=<<font point-size="24">6. builds property<br />automata</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 21 [id=41, label=<<font point-size="24">7. builds reference<br />product and IR</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 29 [id=44, label=<<font point-size="24">8. projects proof<br />obligations</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  29 -> 32 [id=53, label=<<font point-size="24">9. calls Why3/provers</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  32 -> 4 [id=58, label=<<font point-size="24">10. submits proof tasks</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  32 -> 5 [id=60, label=<<font point-size="24">11. uses SMT solver<br />through proof stack</font>>, style="dashed", color="#444444", fontcolor="#444444"]

}
