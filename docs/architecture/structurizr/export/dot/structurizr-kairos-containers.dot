digraph {
  compound=true
  graph [fontname="Arial", rankdir=LR, ranksep=1.0, nodesep=1.0]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">Container View: Kairos</font>>

  1 [id=1,shape=rect, label=<<font point-size="34">Kairos developer</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Develops Kairos programs, runs<br />proofs, inspects artifacts,<br />and keeps the Rocq<br />formalization aligned.</font>>, style=filled, color="#0f3645", fillcolor="#164e63", fontcolor="#ffffff"]
  2 [id=2,shape=rect, label=<<font point-size="34">Rocq formalization</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Formal model of the<br />correction-critical<br />verification kernel.</font>>, style=filled, color="#0a524d", fillcolor="#0f766e", fontcolor="#ffffff"]
  3 [id=3,shape=rect, label=<<font point-size="34">Spot</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External tool used to<br />construct temporal-property<br />automata.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  4 [id=4,shape=rect, label=<<font point-size="34">Why3</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External VC generation and<br />proof-task infrastructure.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  5 [id=5,shape=rect, label=<<font point-size="34">Z3</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External SMT solver used<br />through Why3 and selected<br />internal experiments.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  6 [id=6,shape=rect, label=<<font point-size="34">Graphviz</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External renderer for graph<br />artifacts.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]

  subgraph cluster_7 {
    margin=25
    label=<<font point-size="24"><br />Kairos</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    10 [id=10,shape=rect, label=<<font point-size="34">Engine facade</font><br /><font point-size="19">[Container: OCaml / kairos-engine-runtime]</font><br /><br /><font point-size="24">Stable in-process API<br />distributed by<br />kairos-engine-runtime and used<br />by optional delivery adapters.</font>>, style=filled, color="#043e5d", fillcolor="#075985", fontcolor="#ffffff"]
    11 [id=11,shape=rect, label=<<font point-size="34">Kairos frontend</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Parses the surface language<br />and elaborates it to the core<br />verification model.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
    12 [id=12,shape=rect, label=<<font point-size="34">Application use-cases</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Ports and use-cases that<br />define verification flows<br />independently from concrete<br />adapters.</font>>, style=filled, color="#043e5d", fillcolor="#075985", fontcolor="#ffffff"]
    13 [id=13,shape=rect, label=<<font point-size="34">Domain core</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Core syntax, verification<br />model, shared IR, temporal<br />layout, and formula utilities.</font>>, style=filled, color="#0f4624", fillcolor="#166534", fontcolor="#ffffff"]
    14 [id=14,shape=rect, label=<<font point-size="34">Reference<br />verification kernel</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Validates supplied automata<br />normal form, then builds<br />product summaries and<br />reference proof obligations<br />from the core model.</font>>, style=filled, color="#0f4624", fillcolor="#166534", fontcolor="#ffffff"]
    19 [id=19,shape=rect, label=<<font point-size="34">Proof-kernel export</font><br /><font point-size="19">[Container: OCaml / JSON]</font><br /><br /><font point-size="24">Builds exchange projection<br />data used by diagnostics and<br />possible Rocq synchronization<br />after an adequacy decision.</font>>, style=filled, color="#043e5d", fillcolor="#075985", fontcolor="#ffffff"]
    22 [id=22,shape=rect, label=<<font point-size="34">Runtime orchestration</font><br /><font point-size="19">[Container: OCaml / kairos-engine-runtime]</font><br /><br /><font point-size="24">Coordinates prepared programs,<br />supplied automata, snapshots,<br />outputs, and proof execution<br />inside kairos-engine-runtime.</font>>, style=filled, color="#7d3a06", fillcolor="#b45309", fontcolor="#ffffff"]
    28 [id=28,shape=rect, label=<<font point-size="34">Why3 backend</font><br /><font point-size="19">[Container: OCaml / Why3]</font><br /><br /><font point-size="24">Projects proof obligations to<br />Why3, performs backend-only<br />representation choices, and<br />calls proof services.</font>>, style=filled, color="#850c2a", fillcolor="#be123c", fontcolor="#ffffff"]
    29 [id=29,shape=rect, label=<<font point-size="34">C backend</font><br /><font point-size="19">[Container: OCaml / C]</font><br /><br /><font point-size="24">Projects normalized Kairos<br />programs to portable C99<br />files.</font>>, style=filled, color="#850c2a", fillcolor="#be123c", fontcolor="#ffffff"]
    30 [id=30,shape=rect, label=<<font point-size="34">Artifact renderers</font><br /><font point-size="19">[Container: OCaml / DOT / JSON]</font><br /><br /><font point-size="24">Renders graphs, text views,<br />cost reports, and diagnostic<br />artifacts.</font>>, style=filled, color="#850c2a", fillcolor="#be123c", fontcolor="#ffffff"]
    31 [id=31,shape=rect, label=<<font point-size="34">External tool<br />adapters</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Adapter layer for Spot, Why3,<br />Z3, Graphviz, and timing<br />services.</font>>, style=filled, color="#4a4f59", fillcolor="#6b7280", fontcolor="#ffffff"]
    8 [id=8,shape=rect, label=<<font point-size="34">CLI</font><br /><font point-size="19">[Container: OCaml / Cmdliner]</font><br /><br /><font point-size="24">Command-line entry point for<br />checking, dumping, and proving<br />Kairos programs.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
    9 [id=9,shape=rect, label=<<font point-size="34">LSP server</font><br /><font point-size="19">[Container: OCaml / LSP]</font><br /><br /><font point-size="24">Editor-facing protocol server<br />exposing frontend, proof, and<br />artifact services.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
  }

  1 -> 8 [id=32, label=<<font point-size="24">Runs checks, dumps, and<br />proofs</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  1 -> 9 [id=34, label=<<font point-size="24">Uses editor services</font>>, style="dashed", color="#444444", fontcolor="#444444"]
