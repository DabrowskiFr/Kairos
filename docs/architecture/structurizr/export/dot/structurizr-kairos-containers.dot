digraph {
  compound=true
  graph [fontname="Arial", rankdir=LR, ranksep=1.0, nodesep=1.0]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">Container View: Kairos</font>>

  1 [id=1,shape=rect, label=<<font point-size="34">Kairos developer</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Develops Kairos programs, runs<br />proofs, inspects artifacts,<br />and keeps the Rocq<br />formalization aligned.</font>>, style=filled, color="#0f3645", fillcolor="#164e63", fontcolor="#ffffff"]
  2 [id=2,shape=rect, label=<<font point-size="34">Rocq formalization</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Formal model of the<br />correction-critical<br />verification kernel.</font>>, style=filled, color="#0a524d", fillcolor="#0f766e", fontcolor="#ffffff"]
  3 [id=3,shape=rect, label=<<font point-size="34">Spot</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External tool used to<br />construct temporal-property<br />automata.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  4 [id=4,shape=rect, label=<<font point-size="34">Why3</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External VC generation and<br />proof-task infrastructure.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  5 [id=5,shape=rect, label=<<font point-size="34">Z3</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External SMT solver used<br />through Why3 and selected<br />internal experiments.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  6 [id=6,shape=rect, label=<<font point-size="34">Graphviz</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External renderer for graph<br />artifacts.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]

  subgraph cluster_7 {
    margin=25
    label=<<font point-size="24"><br />Kairos</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    10 [id=10,shape=rect, label=<<font point-size="34">Concrete engine</font><br /><font point-size="19">[Container: OCaml / kairos-engine-runtime]</font><br /><br /><font point-size="24">Public Kairos_engine.Api,<br />private Engine_flow, canonical<br />Pipeline_types contract,<br />focused runtime services, and<br />Kairos-specific output<br />coordination.</font>>, style=filled, color="#7d3a06", fillcolor="#b45309", fontcolor="#ffffff"]
    19 [id=19,shape=rect, label=<<font point-size="34">Kairos frontend</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Parses the surface language<br />and elaborates it to the core<br />verification model.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
    20 [id=20,shape=rect, label=<<font point-size="34">Domain core</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Core syntax, verification<br />model, shared IR, temporal<br />layout, and formula utilities.</font>>, style=filled, color="#0f4624", fillcolor="#166534", fontcolor="#ffffff"]
    21 [id=21,shape=rect, label=<<font point-size="34">Verification domain</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Builds the reference product,<br />summaries and active<br />contracts, then applies<br />obligation-preserving proof<br />planning.</font>>, style=filled, color="#0f4624", fillcolor="#166534", fontcolor="#ffffff"]
    27 [id=27,shape=rect, label=<<font point-size="34">Why3 backend</font><br /><font point-size="19">[Container: OCaml / Why3]</font><br /><br /><font point-size="24">Translates completed proof<br />plans to WhyML and calls proof<br />services.</font>>, style=filled, color="#850c2a", fillcolor="#be123c", fontcolor="#ffffff"]
    28 [id=28,shape=rect, label=<<font point-size="34">C backend</font><br /><font point-size="19">[Container: OCaml / C]</font><br /><br /><font point-size="24">Projects normalized Kairos<br />programs to portable C99<br />files.</font>>, style=filled, color="#850c2a", fillcolor="#be123c", fontcolor="#ffffff"]
    29 [id=29,shape=rect, label=<<font point-size="34">Artifact renderers</font><br /><font point-size="19">[Container: OCaml / DOT / JSON]</font><br /><br /><font point-size="24">Renders graphs, text views,<br />cost reports, and diagnostic<br />artifacts.</font>>, style=filled, color="#850c2a", fillcolor="#be123c", fontcolor="#ffffff"]
    30 [id=30,shape=rect, label=<<font point-size="34">External tool<br />adapters</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Narrow Automata_exchange and<br />Proof_backend_contract<br />boundaries for Spot, Why3, Z3,<br />and timing services.</font>>, style=filled, color="#4a4f59", fillcolor="#6b7280", fontcolor="#ffffff"]
    8 [id=8,shape=rect, label=<<font point-size="34">CLI</font><br /><font point-size="19">[Container: OCaml / Cmdliner]</font><br /><br /><font point-size="24">Command-line entry point for<br />checking, dumping, and proving<br />Kairos programs.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
    9 [id=9,shape=rect, label=<<font point-size="34">LSP server</font><br /><font point-size="19">[Container: OCaml / LSP]</font><br /><br /><font point-size="24">Editor-facing protocol server<br />exposing frontend, proof, and<br />artifact services.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
  }

  1 -> 8 [id=31, label=<<font point-size="24">Runs checks, dumps, and<br />proofs</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  1 -> 9 [id=33, label=<<font point-size="24">Uses editor services</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  8 -> 10 [id=34, label=<<font point-size="24">Invokes Kairos_engine.Api<br />and Api.Contract</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  9 -> 10 [id=35, label=<<font point-size="24">Invokes Kairos_engine.Api<br />and Api.Contract</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 19 [id=36, label=<<font point-size="24">Requests parsing,<br />elaboration, and source<br />inspection</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 28 [id=37, label=<<font point-size="24">Requests portable C<br />generation</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  19 -> 20 [id=38, label=<<font point-size="24">Produces<br />Verification_model</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 21 [id=39, label=<<font point-size="24">Builds the reference<br />product and instrumented<br />IR</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 29 [id=40, label=<<font point-size="24">Builds human-facing<br />outputs</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 27 [id=41, label=<<font point-size="24">Requests Why3 proof<br />projection and execution</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 30 [id=42, label=<<font point-size="24">Requests automata<br />production, timing, and<br />proof services</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  10 -> 6 [id=43, label=<<font point-size="24">Invokes Graphviz on<br />rendered DOT text</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  21 -> 20 [id=45, label=<<font point-size="24">Uses core syntax, IR, and<br />temporal layout</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  27 -> 20 [id=46, label=<<font point-size="24">Compiles formulas,<br />statements, and types</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  27 -> 21 [id=48, label=<<font point-size="24">Translates completed<br />Proof_plan values</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  27 -> 30 [id=49, label=<<font point-size="24">Calls Why3 services</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  28 -> 20 [id=50, label=<<font point-size="24">Compiles normalized<br />program models</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  29 -> 21 [id=51, label=<<font point-size="24">Renders product and<br />automata analyses</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  30 -> 3 [id=52, label=<<font point-size="24">Builds property automata</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  30 -> 4 [id=54, label=<<font point-size="24">Builds and proves Why3<br />tasks</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  30 -> 5 [id=56, label=<<font point-size="24">Runs selected SMT checks</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  2 -> 21 [id=58, label=<<font point-size="24">Checks adequacy against<br />the essential reference<br />boundary</font>>, style="dashed", color="#444444", fontcolor="#444444"]

}
