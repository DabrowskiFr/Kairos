  22 -> 19 [id=45, label=<<font point-size="24">Builds kernel exchange<br />artifacts</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  22 -> 30 [id=46, label=<<font point-size="24">Builds human-facing<br />outputs</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  22 -> 28 [id=47, label=<<font point-size="24">Requests Why3 proof<br />projection and execution</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  22 -> 31 [id=48, label=<<font point-size="24">Requests automata<br />production, graph<br />rendering, timing, and<br />proof services</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  14 -> 13 [id=49, label=<<font point-size="24">Uses core syntax, IR, and<br />temporal layout</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  19 -> 13 [id=50, label=<<font point-size="24">Serializes core formulas<br />and signatures</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  19 -> 14 [id=51, label=<<font point-size="24">Uses product and automata<br />analysis</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  28 -> 13 [id=52, label=<<font point-size="24">Compiles formulas,<br />statements, and types</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  28 -> 14 [id=53, label=<<font point-size="24">Consumes product summaries</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  28 -> 31 [id=54, label=<<font point-size="24">Calls Why3 services</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  29 -> 13 [id=55, label=<<font point-size="24">Compiles normalized<br />program models</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  30 -> 14 [id=56, label=<<font point-size="24">Renders product and<br />automata analyses</font>>, style="dashed", color="#444444", fontcolor="#444444"]
