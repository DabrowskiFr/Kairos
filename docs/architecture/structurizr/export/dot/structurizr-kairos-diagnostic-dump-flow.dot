digraph {
  compound=true
  graph [fontname="Arial", rankdir=TB, ranksep=1.0, nodesep=1.0]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">Dynamic View: Kairos</font>>

  subgraph cluster_7 {
    margin=25
    label=<<font point-size="24"><br />Kairos</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    11 [id=11,shape=rect, label=<<font point-size="34">Application use-cases</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Ports and use-cases that<br />define verification flows<br />independently from concrete<br />adapters.</font>>, style=filled, color="#043e5d", fillcolor="#075985", fontcolor="#ffffff"]
    13 [id=13,shape=rect, label=<<font point-size="34">Reference<br />verification kernel</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Builds product summaries and<br />reference proof obligations<br />from the core model plus<br />supplied automata.</font>>, style=filled, color="#0f4624", fillcolor="#166534", fontcolor="#ffffff"]
    18 [id=18,shape=rect, label=<<font point-size="34">Proof-kernel export</font><br /><font point-size="19">[Container: OCaml / JSON]</font><br /><br /><font point-size="24">Builds versioned kernel<br />exchange data used by<br />diagnostics and future Rocq<br />synchronization.</font>>, style=filled, color="#0f4624", fillcolor="#166534", fontcolor="#ffffff"]
    21 [id=21,shape=rect, label=<<font point-size="34">Runtime orchestration</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Coordinates prepared programs,<br />supplied automata, snapshots,<br />outputs, and proof execution.</font>>, style=filled, color="#7d3a06", fillcolor="#b45309", fontcolor="#ffffff"]
    28 [id=28,shape=rect, label=<<font point-size="34">Artifact renderers</font><br /><font point-size="19">[Container: OCaml / DOT / JSON]</font><br /><br /><font point-size="24">Renders graphs, text views,<br />cost reports, and diagnostic<br />artifacts.</font>>, style=filled, color="#850c2a", fillcolor="#be123c", fontcolor="#ffffff"]
    29 [id=29,shape=rect, label=<<font point-size="34">External tool<br />adapters</font><br /><font point-size="19">[Container: OCaml]</font><br /><br /><font point-size="24">Adapter layer for Spot, Why3,<br />Z3, Graphviz, and timing<br />services.</font>>, style=filled, color="#4a4f59", fillcolor="#6b7280", fontcolor="#ffffff"]
    8 [id=8,shape=rect, label=<<font point-size="34">CLI</font><br /><font point-size="19">[Container: OCaml / Cmdliner]</font><br /><br /><font point-size="24">Command-line entry point for<br />checking, dumping, and proving<br />Kairos programs.</font>>, style=filled, color="#5628a5", fillcolor="#7c3aed", fontcolor="#ffffff"]
  }

  1 [id=1,shape=rect, label=<<font point-size="34">Kairos developer</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Develops Kairos programs, runs<br />proofs, inspects artifacts,<br />and keeps the Rocq<br />formalization aligned.</font>>, style=filled, color="#0f3645", fillcolor="#164e63", fontcolor="#ffffff"]
  3 [id=3,shape=rect, label=<<font point-size="34">Spot</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External tool used to<br />construct temporal-property<br />automata.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]
  6 [id=6,shape=rect, label=<<font point-size="34">Graphviz</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External renderer for graph<br />artifacts.</font>>, style=filled, color="#262d38", fillcolor="#374151", fontcolor="#ffffff"]

  1 -> 8 [id=30, label=<<font point-size="24">1. requests diagnostic<br />dump</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  8 -> 11 [id=33, label=<<font point-size="24">2. invokes dump use-case</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  11 -> 21 [id=36, label=<<font point-size="24">3. builds snapshot and<br />artifacts</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  21 -> 29 [id=43, label=<<font point-size="24">4. produces supplied<br />automata through Spot<br />adapter</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  29 -> 3 [id=52, label=<<font point-size="24">5. builds property<br />automata</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  21 -> 13 [id=39, label=<<font point-size="24">6. builds reference<br />product</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  21 -> 18 [id=40, label=<<font point-size="24">7. builds proof-kernel<br />diagnostic view</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  21 -> 28 [id=41, label=<<font point-size="24">8. renders text/graph<br />outputs</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  28 -> 29 [id=51, label=<<font point-size="24">9. uses Graphviz when<br />needed</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  29 -> 6 [id=58, label=<<font point-size="24">10. renders graph images</font>>, style="dashed", color="#444444", fontcolor="#444444"]

}