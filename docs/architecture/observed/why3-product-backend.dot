digraph "why3_product_backend" {
  graph [
    rankdir=LR,
    label="Observed Why3 product backend dependencies (arrow = depends on)",
    labelloc=t,
    fontname="Helvetica",
    fontsize=18,
    compound=true,
    bgcolor="white"
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#f8fafc", color="#475569"];
  edge [fontname="Helvetica", fontsize=9, color="#64748b", arrowsize=0.7];

  subgraph cluster_0 {
    label="Domain Planning";
    style="rounded,filled";
    color="#dbeafe";
    fillcolor="#ffffff";
    "Step_contract_projection" [label="Step_contract_projection"];
    "Contract_formula_index" [label="Contract_formula_index"];
    "Proof_plan" [label="Proof_plan"];
  }

  subgraph cluster_1 {
    label="Product Orchestration";
    style="rounded,filled";
    color="#dcfce7";
    fillcolor="#ffffff";
    "Why_compile" [label="Why_compile"];
    "Why_compile_bundles" [label="Why_compile_bundles"];
    "Why_compile_modules" [label="Why_compile_modules"];
  }

  subgraph cluster_2 {
    label="Why Translation";
    style="rounded,filled";
    color="#fef3c7";
    fillcolor="#ffffff";
    "Why_compile_formula_sharing" [label="Why_compile_formula_sharing"];
    "Why_compile_product_specs" [label="Why_compile_product_specs"];
  }

  subgraph cluster_3 {
    label="Helper Emission";
    style="rounded,filled";
    color="#fce7f3";
    fillcolor="#ffffff";
    "Why_compile_product_helpers" [label="Why_compile_product_helpers"];
    "Why_compile_step" [label="Why_compile_step"];
  }

  subgraph cluster_4 {
    label="Compile Services";
    style="rounded,filled";
    color="#e0e7ff";
    fillcolor="#ffffff";
    "Why_compile_ptree_helpers" [label="Why_compile_ptree_helpers"];
    "Why_compile_expr" [label="Why_compile_expr"];
    "Why_product_step_names" [label="Why_product_step_names"];
  }

  "Proof_plan" -> "Contract_formula_index";
  "Proof_plan" -> "Step_contract_projection";
  "Why_compile" -> "Why_compile_modules";
  "Why_compile_bundles" -> "Why_compile_ptree_helpers";
  "Why_compile_formula_sharing" -> "Why_compile_ptree_helpers";
  "Why_compile_modules" -> "Why_compile_product_helpers";
  "Why_compile_product_helpers" -> "Why_compile_product_specs";
  "Why_compile_product_helpers" -> "Why_compile_step";
  "Why_compile_product_helpers" -> "Why_product_step_names";
  "Why_compile_product_specs" -> "Why_compile_bundles";
  "Why_compile_product_specs" -> "Why_compile_formula_sharing";
  "Why_compile_ptree_helpers" -> "Why_compile_expr";
  "Why_compile_step" -> "Why_compile_ptree_helpers";
}
