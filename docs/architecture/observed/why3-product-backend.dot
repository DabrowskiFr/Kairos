digraph "why3_product_backend" {
  graph [
    rankdir=LR,
    label="Observed Why3 product backend dependencies (arrow = depends on)",
    labelloc=t,
    fontname="Helvetica",
    fontsize=18,
    compound=true,
    bgcolor="white"
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#f8fafc", color="#475569"];
  edge [fontname="Helvetica", fontsize=9, color="#64748b", arrowsize=0.7];

  subgraph cluster_0 {
    label="Orchestration";
    style="rounded,filled";
    color="#dbeafe";
    fillcolor="#ffffff";
    "Why_compile_product_pipeline" [label="Why_compile_product_pipeline"];
    "Why_compile_product_bundle_state" [label="Why_compile_product_bundle_state"];
    "Why_compile_product_plan" [label="Why_compile_product_plan"];
    "Why_compile_product_plan_metrics" [label="Why_compile_product_plan_metrics"];
    "Why_compile_product_metrics" [label="Why_compile_product_metrics"];
  }

  subgraph cluster_1 {
    label="Helper Plan";
    style="rounded,filled";
    color="#dcfce7";
    fillcolor="#ffffff";
    "Why_compile_product_groups" [label="Why_compile_product_groups"];
    "Why_compile_product_group_partition" [label="Why_compile_product_group_partition"];
    "Why_compile_product_group_policy" [label="Why_compile_product_group_policy"];
    "Why_compile_product_group_terms" [label="Why_compile_product_group_terms"];
    "Why_compile_product_group_factoring" [label="Why_compile_product_group_factoring"];
    "Why_compile_product_group_cost" [label="Why_compile_product_group_cost"];
    "Why_compile_product_group_boundary" [label="Why_compile_product_group_boundary"];
  }

  subgraph cluster_2 {
    label="Helper Specs";
    style="rounded,filled";
    color="#fef3c7";
    fillcolor="#ffffff";
    "Why_compile_product_specs" [label="Why_compile_product_specs"];
    "Why_compile_product_spec_terms" [label="Why_compile_product_spec_terms"];
    "Why_compile_product_spec_labels" [label="Why_compile_product_spec_labels"];
  }

  subgraph cluster_3 {
    label="Helper Emission";
    style="rounded,filled";
    color="#fce7f3";
    fillcolor="#ffffff";
    "Why_compile_product_helpers" [label="Why_compile_product_helpers"];
    "Why_compile_product_individual_helper" [label="Why_compile_product_individual_helper"];
    "Why_compile_product_grouped_helper" [label="Why_compile_product_grouped_helper"];
    "Why_compile_helper_unit" [label="Why_compile_helper_unit"];
    "Why_compile_product_helper_types" [label="Why_compile_product_helper_types"];
    "Why_compile_product_helper_body" [label="Why_compile_product_helper_body"];
    "Why_compile_product_layout" [label="Why_compile_product_layout"];
  }

  subgraph cluster_4 {
    label="Nearby Compile Services";
    style="rounded,filled";
    color="#e0e7ff";
    fillcolor="#ffffff";
    "Why_product_step_names" [label="Why_product_step_names"];
    "Why_compile_contract_facts" [label="Why_compile_contract_facts"];
    "Why_compile_step" [label="Why_compile_step"];
    "Why_compile_bundles" [label="Why_compile_bundles"];
    "Why_compile_modules" [label="Why_compile_modules"];
    "Why_compile_ptree_helpers" [label="Why_compile_ptree_helpers"];
  }

  "Why_compile_bundles" -> "Why_compile_ptree_helpers";
  "Why_compile_contract_facts" -> "Why_compile_bundles";
  "Why_compile_modules" -> "Why_compile_helper_unit";
