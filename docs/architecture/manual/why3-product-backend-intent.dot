digraph Why3ProductBackendIntent {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.25",
    nodesep="0.50",
    ranksep="0.70",
    fontname="Helvetica",
    labelloc="t",
    label="Intentional Why3 product backend architecture"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    margin="0.10,0.07",
    color="#1f2937"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#374151",
    arrowsize=0.75
  ];

  canonical [
    label="Formalization + exported IR/kobj\ncanonical obligations",
    fillcolor="#dcfce7",
    penwidth=2
  ];

  step_projection [
    label="Step_contract_projection\nneutral step contracts",
    fillcolor="#e0f2fe"
  ];

  compile [
    label="Why_compile\nnode compilation facade",
    fillcolor="#dbeafe",
    penwidth=2
  ];

  specs [
    label="Why_compile_product_specs\ndirect helper specs",
    fillcolor="#fde68a",
    penwidth=2
  ];

  bundles [
    label="Why_compile_bundles\ncompact multi-clause predicates",
    fillcolor="#e0e7ff"
  ];

  groups [
    label="Why_compile_product_groups\npartition + policy + helper plan",
    fillcolor="#bbf7d0",
    penwidth=2
  ];

  terms [
    label="Why_compile_product_group_terms\ngrouped terms + canonical pre factoring",
    fillcolor="#fef3c7",
    penwidth=2
  ];

  helpers [
    label="Why_compile_product_helpers\nindividual/grouped helper emission",
    fillcolor="#fecdd3",
    penwidth=2
  ];

  step_compile [
    label="Why_compile_step\nselected body compilation",
    fillcolor="#fee2e2"
  ];

  modules [
    label="Why_compile_modules\nfinal Why3 module assembly",
    fillcolor="#ede9fe"
  ];

  ptree_helpers [
    label="Why_compile_ptree_helpers\nterm/name/binder utilities",
    fillcolor="#e0e7ff"
  ];

  step_names [
    label="Why_product_step_names\nstable helper names",
    fillcolor="#fee2e2"
  ];


  canonical -> step_projection [label="project"];
  canonical -> compile [label="node IR"];
  step_projection -> specs [label="direct input"];

  compile -> bundles [label="own post bundles"];
  compile -> groups [label="build plan"];
  compile -> helpers [label="emit"];
  compile -> modules [label="assemble"];

  specs -> bundles [style=dashed, label="compact contracts"];
  specs -> ptree_helpers [style=dashed, label="Ptree construction"];
  groups -> specs [label="fact terms"];
  groups -> terms [label="group terms"];
  terms -> ptree_helpers [style=dashed, label="term combinators"];

  helpers -> groups [label="consume plan"];
  helpers -> specs [label="consume specs"];
  helpers -> step_compile [label="compile body"];
  helpers -> step_names [label="stable names"];
  modules -> helpers [label="consume helper units"];

  subgraph cluster_rules {
    label="Architectural rules";
    fontsize=11;
    color="#9ca3af";
    style="rounded,dashed";

    rule_reference [
      label="Generated Why3 is a projection.\nIt does not define temporal semantics.",
      fillcolor="#dcfce7"
    ];

    rule_equivalence [
      label="Compact predicates, grouping and canonical\nfactoring preserve selected obligations.",
      fillcolor="#fef3c7"
    ];

    rule_metrics [
      label="Profiles and timings never feed back\ninto specs or helper planning.",
      fillcolor="#e5e7eb"
    ];
  }
}
