digraph Why3ProductBackendIntent {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.25",
    nodesep="0.50",
    ranksep="0.70",
    fontname="Helvetica",
    labelloc="t",
    label="Intentional proof-planning and Why3 translation architecture"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    margin="0.10,0.07",
    color="#1f2937"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#374151",
    arrowsize=0.75
  ];

  canonical [
    label="Formalization + exported IR/kobj\ncanonical obligations",
    fillcolor="#dcfce7",
    penwidth=2
  ];

  step_projection [
    label="Step_contract_projection\npartition-local neutral contracts",
    fillcolor="#e0f2fe"
  ];

  proof_plan [
    label="Proof_plan\nprovenance + grouping + factoring + sharing",
    fillcolor="#bbf7d0",
    penwidth=2
  ];

  compile [
    label="Why_compile\nmechanical plan translator",
    fillcolor="#dbeafe",
    penwidth=2
  ];

  specs [
    label="Why_compile_product_specs\ndirect helper specs",
    fillcolor="#fde68a",
    penwidth=2
  ];

  bundles [
    label="Why_compile_bundles\nemit preselected shared predicates",
    fillcolor="#e0e7ff"
  ];

  formula_sharing [
    label="Why_compile_formula_sharing\nemit preselected formula definitions",
    fillcolor="#e0e7ff"
  ];

  helpers [
    label="Why_compile_product_helpers\nindividual/grouped helper emission",
    fillcolor="#fecdd3",
    penwidth=2
  ];

  step_compile [
    label="Why_compile_step\nselected body compilation",
    fillcolor="#fee2e2"
  ];

  modules [
    label="Why_compile_modules\nfinal Why3 module assembly",
    fillcolor="#ede9fe"
  ];

  ptree_helpers [
    label="Why_compile_ptree_helpers\nterm/name/binder utilities",
    fillcolor="#e0e7ff"
  ];

  step_names [
    label="Why_product_step_names\nstable helper names",
    fillcolor="#fee2e2"
  ];


  canonical -> step_projection [label="project per partition"];
  step_projection -> proof_plan [label="plan once"];
  proof_plan -> compile [label="completed plan"];

  compile -> bundles [label="emit sharing"];
  compile -> formula_sharing [label="emit index"];
  compile -> specs [label="translate conditions"];
  compile -> helpers [label="emit"];
  compile -> modules [label="assemble"];

  specs -> bundles [style=dashed, label="resolve shared ids"];
  specs -> ptree_helpers [style=dashed, label="Ptree construction"];

  helpers -> specs [label="consume specs"];
  helpers -> proof_plan [label="consume selected obligation"];
  helpers -> step_compile [label="compile body"];
  helpers -> step_names [label="stable names"];
  modules -> helpers [label="consume helper units"];

  subgraph cluster_rules {
    label="Architectural rules";
    fontsize=11;
    color="#9ca3af";
    style="rounded,dashed";

    rule_reference [
      label="Generated Why3 is a projection.\nIt does not define temporal semantics.",
      fillcolor="#dcfce7"
    ];

    rule_equivalence [
      label="Grouping, factoring and sharing are fixed\nbefore any Why3 term is constructed.",
      fillcolor="#fef3c7"
    ];

    rule_metrics [
      label="Profiles and timings never feed back\ninto specs or helper planning.",
      fillcolor="#e5e7eb"
    ];
  }
}
