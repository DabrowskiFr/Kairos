digraph KairosCorrectionPath {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.25",
    nodesep="0.45",
    ranksep="0.55",
    fontname="Helvetica",
    labelloc="t",
    label="Essential correction boundary for Rocq adequacy"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=12,
    margin="0.12,0.08",
    color="#1f2937"
  ];

  edge [
    fontname="Helvetica",
    fontsize=10,
    color="#374151",
    arrowsize=0.8
  ];

  surface [
    label="Surface Kairos\nsyntax sugar, observers, actions",
    fillcolor="#ede9fe"
  ];

  elaboration [
    label="Elaboration frontier\nsurface -> core model\nnot yet the Rocq kernel",
    fillcolor="#ddd6fe"
  ];

  core [
    label="Core program model\nVerification_model + Core_syntax",
    fillcolor="#dcfce7",
    penwidth=2
  ];

  automata [
    label="Assumption/guarantee automata\nexternal parameters of the kernel\nSpot is outside this box",
    fillcolor="#e5e7eb"
  ];

  product [
    label="Reference product\nprogram states x automata states\nProduct_build / From_model",
    fillcolor="#bbf7d0",
    penwidth=3
  ];

  prepost [
    label="Essential obligation shaping\nPre / Post\nsource and destination obligations",
    fillcolor="#86efac",
    penwidth=3
  ];

  reachability [
    label="Reachability invariant extension\nProduct_reachability\nnot pruning",
    fillcolor="#fde68a",
    penwidth=2
  ];

  temporal [
    label="Reference temporal normalization\nTemporal_lower\npre/pre_k -> temporal layout",
    fillcolor="#86efac",
    penwidth=3
  ];

  obligations [
    label="Essential obligations\ncorrection / progression\nrelative completeness",
    fillcolor="#4ade80",
    penwidth=3
  ];

  kernel_export [
    label="Proof-kernel export\nProof_kernel_types.node_ir\nprojection candidate",
    fillcolor="#dbeafe",
    penwidth=2
  ];

  rocq [
    label="Rocq formalization\nadequacy against essential boundary",
    shape=oval,
    fillcolor="#dcfce7",
    penwidth=2
  ];

  backend [
    label="Why3 backend\nslicing, grouping, printing, solver calls\nnot the source of truth",
    fillcolor="#fecdd3"
  ];

  external [
    label="External tools\nSpot, Why3, Z3, Graphviz",
    fillcolor="#e5e7eb"
  ];

  surface -> elaboration;
  elaboration -> core;
  core -> product;
  automata -> product;
  product -> prepost;
  prepost -> temporal;
  temporal -> obligations;
  obligations -> rocq [label="adequacy check"];
  prepost -> reachability [style=dashed, label="optional invariant scheme"];
  reachability -> obligations [style=dashed];
  obligations -> kernel_export [style=dashed, label="derived exchange view"];
  kernel_export -> rocq [style=dashed, label="optional sync format"];

  temporal -> backend [style=dashed, label="lowered, interned formulas"];
  backend -> external [style=dashed];
  external -> automata [style=dashed, label="Spot may produce them"];
}
