digraph KairosArchitectureMap {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.25",
    nodesep="0.55",
    ranksep="0.75",
    fontname="Helvetica",
    labelloc="t",
    label="Kairos architecture map: read left to right"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=12,
    margin="0.12,0.08",
    color="#1f2937"
  ];

  edge [
    fontname="Helvetica",
    fontsize=10,
    color="#374151",
    arrowsize=0.8
  ];

  user [
    label="User / editor\nruns, inspects, proves",
    shape=oval,
    fillcolor="#e0f2fe"
  ];

  cli [
    label="CLI + LSP\nbin/cli, bin/lsp",
    fillcolor="#ede9fe"
  ];

  frontend [
    label="Surface frontend\nparse + elaborate\nlib/adapters/in/kairos_lang",
    fillcolor="#ede9fe"
  ];

  app [
    label="Application use-cases\nports + flows\nlib/application",
    fillcolor="#dbeafe"
  ];

  core [
    label="Domain core\nsyntax, model, IR, temporal layout\nlib/domain/core",
    fillcolor="#dcfce7",
    penwidth=2
  ];

  kernel [
    label="Reference verification kernel\nprogram x automata -> obligations\nlib/domain/verification",
    fillcolor="#bbf7d0",
    penwidth=3
  ];

  proof_export [
    label="Proof-kernel export\ndiagnostics / Rocq exchange\nlib/domain/proof_export",
    fillcolor="#86efac",
    penwidth=3
  ];

  runtime [
    label="Runtime orchestration\ncore / proof / diagnostics / facade\nlib/adapters/out/runtime",
    fillcolor="#fed7aa"
  ];

  why3_backend [
    label="Why3 backend\nprojection + backend optimizations\nlib/adapters/out/provers/why3",
    fillcolor="#fecdd3"
  ];

  artifacts [
    label="Artifact renderers\ntext, graphs, reports\nlib/adapters/out/artifacts",
    fillcolor="#fee2e2"
  ];

  external [
    label="External tools\nSpot, Why3, Z3, Graphviz\nlib/adapters/out/external",
    fillcolor="#e5e7eb"
  ];

  rocq [
    label="Rocq formalization\nsyncs with proof-kernel export",
    shape=oval,
    fillcolor="#dcfce7",
    penwidth=2
  ];

  user -> cli;
  cli -> app;
  cli -> frontend [label="parse/check"];
  app -> frontend [label="frontend port"];
  frontend -> core [label="elaborated model"];
  app -> runtime [label="build snapshot"];
  runtime -> core;
  runtime -> kernel [label="reference product"];
  runtime -> proof_export [label="kernel data"];
  runtime -> artifacts [label="human outputs"];
  runtime -> external [label="Spot/Graphviz/timing"];
  kernel -> core;
  proof_export -> core;
  proof_export -> kernel;
  why3_backend -> core;
  why3_backend -> kernel;
  runtime -> why3_backend [label="prove/dump why"];
  why3_backend -> external [label="Why3/Z3"];
  artifacts -> external [label="Graphviz"];
  proof_export -> rocq [label="versioned boundary"];

  subgraph cluster_legend {
    label="Legend";
    fontsize=11;
    color="#9ca3af";
    style="rounded,dashed";
    legend_reference [
      label="green = correction-critical / Rocq-visible",
      fillcolor="#bbf7d0"
    ];
    legend_adapter [
      label="purple/blue = entry + use-case wiring",
      fillcolor="#dbeafe"
    ];
    legend_runtime [
      label="orange/red = runtime, artifacts, backend",
      fillcolor="#fed7aa"
    ];
    legend_external [
      label="gray = external tools",
      fillcolor="#e5e7eb"
    ];
  }
}
